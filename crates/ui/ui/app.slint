// Interface (SPEC-05): início, espera, sala e "Sobre".
// Só tokens da paleta; nenhuma animação.

import { ScrollView, Palette, AboutSlint } from "std-widgets.slint";

// Hex do Color.kt do LerriNFC (P-01). Contraste conferido em tests/contrast.rs:
// todo par texto/fundo usado passa AA, menos text-mute (só desabilitado).
export global Theme {
    out property <color> ink: #0B0710;
    out property <color> surface: #150E1F;
    out property <color> surface-raised: #1C1329;
    out property <color> surface-hover: #271A38;
    out property <color> border: #342447;
    out property <color> violet: #B36BFF;
    out property <color> violet-bright: #CB9BFF;
    out property <color> violet-deep: #8E7BFF;
    out property <color> violet-glow: #B36BFF40;
    out property <color> violet-dim: #2E1A47;
    out property <color> on-violet: #1A0A2E;
    out property <color> text: #F2ECFB;
    out property <color> text-dim: #B4A3C9;
    out property <color> text-placeholder: #8E83A8;
    out property <color> text-mute: #766288;
    out property <color> success: #3DDC97;
    out property <color> warning: #FFB454;
    out property <color> danger: #FF5A6E;
    out property <color> success-dim: #0F3327;
    out property <color> warning-dim: #3A2A14;
    out property <color> danger-dim: #3A1620;
}

export struct SavedRoomRow {
    id: string,
    label: string,
}

export struct ChatRow {
    who: string,
    text: string,
    time: string,
    mine: bool,
}

export struct MemberRow {
    label: string,
    online: bool,
    owner: bool,
    me: bool,
    waiting: bool,
    in-voice: bool,
    speaking: bool,
    sharing: bool,
    watching: bool,
    camera: bool,
    watching-camera: bool,
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    callback clicked;
    height: 36px;
    min-width: label.preferred-width + 32px;
    border-radius: 6px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.danger : Theme.border;
    background: !enabled ? Theme.surface-raised
        : primary ? (ta.pressed ? Theme.violet-deep : ta.has-hover ? Theme.violet-bright : Theme.violet)
        : (ta.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.clicked(); }
    }
    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: root.font-size;
        color: !root.enabled ? Theme.text-mute : root.primary ? Theme.on-violet : root.danger ? Theme.danger : Theme.text;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
}

component Title inherits Text {
    color: Theme.text;
    font-size: 20px;
    font-weight: 600;
}

component Dim inherits Text {
    color: Theme.text-dim;
    wrap: word-wrap;
}

component Dot inherits Rectangle {
    in property <color> tone;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone;
}

// Presença na lista de membros: ponto de online; na voz, anel roxo estático
// enquanto fala (SPEC-05: sem animação contínua no renderer software).
component Presence inherits Rectangle {
    in property <bool> online;
    in property <bool> speaking;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: speaking ? Theme.violet-glow : transparent;
    border-width: speaking ? 2px : 0px;
    border-color: Theme.violet-bright;
    Dot {
        x: 3px;
        y: 3px;
        tone: root.online ? Theme.success : Theme.text-mute;
    }
}

// Campo de texto de uma linha com os tokens da paleta (o LineEdit padrão usa
// o azul de destaque do Fluent e o Palette não pode ser trocado). Rola o
// texto para manter o cursor à vista, como o LineEdit.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    callback accepted();
    callback edited();
    property <length> pad: 10px;
    property <length> scroll: 10px;

    height: 36px;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: Theme.surface-raised;
    border-width: 1px;
    border-color: input.has-focus ? Theme.violet : Theme.border;
    clip: true;
    accessible-role: text-input;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-enabled: root.enabled;

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if root.text == "": Text {
        x: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height;
        text: root.placeholder-text;
        color: root.enabled ? Theme.text-placeholder : Theme.text-mute;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: min(root.pad, max(parent.width - self.width - root.pad, root.scroll));
        width: max(parent.width - 2 * root.pad, self.preferred-width);
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        input-type: root.input-type;
        single-line: true;
        vertical-alignment: center;
        color: root.enabled ? Theme.text : Theme.text-mute;
        selection-background-color: Theme.violet-dim;
        selection-foreground-color: Theme.text;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        cursor-position-changed(pos) => {
            if (pos.x + root.scroll < root.pad) {
                root.scroll = root.pad - pos.x;
            } else if (pos.x + root.scroll > root.width - 2 * root.pad - 2px) {
                root.scroll = root.width - root.pad - pos.x - 2px;
            }
        }
    }
}

// Caixa de seleção: quadrado com miolo roxo quando marcada, mais o texto.
component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled();

    min-height: 32px;
    min-width: label.preferred-width + 28px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { ta.clicked(); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    box := Rectangle {
        x: 0px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: root.checked || ta.has-hover ? Theme.violet : Theme.border;
        background: Theme.surface-raised;
        Rectangle {
            visible: root.checked;
            width: 10px;
            height: 10px;
            border-radius: 2px;
            background: Theme.violet;
        }
    }
    label := Text {
        x: 28px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        vertical-alignment: center;
    }
}

// Lista de escolha (monitor, câmera). Fica na barra de baixo, então a lista
// abre para cima.
component Picker inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    property <length> item-height: 32px;

    height: 36px;
    min-width: 100px;
    border-radius: 6px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.violet : Theme.border;
    background: Theme.surface-raised;
    accessible-role: combobox;
    accessible-value: root.model[root.current-index];
    accessible-action-default => { popup.show(); }
    accessible-expandable: true;
    accessible-action-expand => { popup.show(); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    Text {
        x: 10px;
        width: parent.width - 34px;
        height: parent.height;
        text: root.model[root.current-index];
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 22px;
        height: parent.height;
        text: "▲";
        font-size: 9px;
        color: Theme.text-dim;
        vertical-alignment: center;
    }
    popup := PopupWindow {
        x: 0px;
        y: -(root.model.length * root.item-height + 10px);
        width: max(root.width, 220px);
        Rectangle {
            background: Theme.surface-raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 4px;
                for item[i] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 4px;
                    background: ita.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: item;
                        color: i == root.current-index ? Theme.violet-bright : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-index = i; }
                    }
                }
            }
        }
    }
}

component HomeView inherits VerticalLayout {
    in property <string> my-id;
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;
    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();
    callback about();

    padding: 24px;
    spacing: 16px;

    HorizontalLayout {
        spacing: 16px;
        Text { text: "Lerri Chat"; color: Theme.text; font-size: 28px; font-weight: 600; vertical-alignment: center; }
        Rectangle { }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Apelido"; color: Theme.text-dim; vertical-alignment: center; }
                Field {
                    width: 200px;
                    text <=> root.nickname;
                    placeholder-text: "opcional, só a sala vê";
                    edited => { root.save-settings(); }
                }
            }
            HorizontalLayout {
                alignment: end;
                Check {
                    text: "Guardar histórico do chat neste PC";
                    checked <=> root.keep-history;
                    toggled => { root.save-settings(); }
                }
            }
            Text { text: "id: " + root.my-id + "…"; color: Theme.text-dim; font-family: "Cascadia Mono"; font-size: 12px; horizontal-alignment: right; }
        }
        VerticalLayout {
            alignment: start;
            Btn { text: "Sobre"; clicked => { root.about(); } }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Entrar numa sala"; }
                Dim { text: "Cole o convite que recebeu (lerrichat://join…)."; }
                Field {
                    text <=> root.join-link;
                    placeholder-text: "lerrichat://join?…";
                    accepted => { root.join(); }
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Entrar"; primary: true; enabled: root.join-link != ""; clicked => { root.join(); } }
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Criar sala x1"; }
                Dim { text: "Sala direta entre dois PCs, hospedada neste aqui. Acaba quando você fechar o app."; }
                Dim { text: "O Windows pode perguntar se o Lerri Chat pode usar a rede: permita, senão ninguém de fora consegue entrar."; font-size: 12px; }
                Field {
                    text <=> root.via-link;
                    placeholder-text: "opcional: link público do seu relay (lerrichat://relay…)";
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Criar sala x1"; primary: true; clicked => { root.create-x1(); } }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Minhas salas"; }
                if root.saved-rooms.length == 0: Dim { text: "Nenhuma sala salva. Salas de servidor aparecem aqui depois que você entra nelas."; }
                for room[i] in root.saved-rooms: HorizontalLayout {
                    spacing: 12px;
                    Text { text: room.id; color: Theme.text; font-family: "Cascadia Mono"; vertical-alignment: center; }
                    Text { text: room.label; color: Theme.text-dim; vertical-alignment: center; }
                    Rectangle { }
                    Btn { text: "Abrir"; clicked => { root.open-room(i); } }
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Criar sala num servidor"; }
                Dim { text: "Para quem roda um relay (lerrichat-host). Use o link de administração que ele mostra."; }
                Field {
                    text <=> root.admin-link;
                    placeholder-text: "lerrichat://admin?…";
                    input-type: password;
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Criar no servidor"; enabled: root.admin-link != ""; clicked => { root.create-server(); } }
                }
            }
        }
    }
    Rectangle { }
}

// Separador vertical da barra de controle.
component Bar inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

component RoomView inherits VerticalLayout {
    in property <string> room-id;
    in property <string> room-info;
    in property <string> room-status;
    in property <string> route-text;
    // 0: bom · 1: atenção (latência alta ou pelo ponto de encontro) · 2: ruim.
    in property <int> route-quality;
    in property <string> reach-text;
    in property <string> reach-note;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    // Tela: a nossa e a que assistimos.
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in property <string> watching-label;
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch();
    // Câmera: a nossa e a que assistimos.
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    in property <string> watching-cam-label;
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera();
    // Onde as janelas de vídeo (filhas, D3D11) ficam, em pixels lógicos.
    out property <length> video-x: video-box.absolute-position.x;
    out property <length> video-y: video-box.absolute-position.y;
    out property <length> video-width: video-box.width;
    out property <length> video-height: video-box.height;
    out property <length> cam-x: cam-box.absolute-position.x;
    out property <length> cam-y: cam-box.absolute-position.y;
    out property <length> cam-width: cam-box.width;
    out property <length> cam-height: cam-box.height;

    property <bool> confirm-leave;
    property <int> confirm-remove: -1;
    property <bool> show-addresses;
    property <bool> admitted: root.room-status == "";

    public function scroll-to-end() {
        chat-sv.content-y = min(0px, chat-sv.visible-height - chat-sv.content-height);
    }

    HorizontalLayout {
        vertical-stretch: 1;
        padding: 20px;
        padding-bottom: 12px;
        spacing: 16px;

        VerticalLayout {
            spacing: 12px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    Title { text: "Sala " + root.room-id; font-family: "Cascadia Mono"; }
                    Dim { text: root.room-info; }
                }
                Rectangle { }
                if root.is-owner: VerticalLayout {
                    alignment: center;
                    Btn { text: root.show-invite ? "Ocultar convite" : "Convidar"; clicked => { root.show-invite = !root.show-invite; } }
                }
                VerticalLayout {
                    alignment: center;
                    Btn { text: "Desconectar"; clicked => { root.disconnect(); } }
                }
                if !root.is-owner: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.confirm-leave ? "Confirmar: sair de vez" : "Sair da sala";
                        danger: true;
                        clicked => {
                            if (root.confirm-leave) { root.leave-room(); } else { root.confirm-leave = true; }
                        }
                    }
                }
            }

            // Indicador de rede: ponto + latência; a cor acompanha a qualidade
            // e o texto diz o caminho (o estado não depende só da cor).
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Dot { tone: root.route-text == "" ? Theme.text-mute : root.route-quality == 0 ? Theme.success : root.route-quality == 1 ? Theme.warning : Theme.danger; }
                }
                Text {
                    text: root.route-text == "" ? "sem conexão" : root.route-text;
                    color: root.route-quality == 2 && root.route-text != "" ? Theme.danger : Theme.text-dim;
                    vertical-alignment: center;
                }
            }

            if root.confirm-leave && !root.is-owner: Rectangle {
                background: Theme.danger-dim;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.danger;
                HorizontalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Text {
                        text: "Sair de vez apaga a sala deste PC. Para voltar, você vai precisar de um convite novo.";
                        color: Theme.text;
                        wrap: word-wrap;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Btn { text: "Cancelar"; clicked => { root.confirm-leave = false; } }
                }
            }

            if root.room-status != "": Rectangle {
                background: Theme.warning-dim;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.warning;
                HorizontalLayout {
                    padding: 12px;
                    Text { text: root.room-status; color: Theme.warning; wrap: word-wrap; }
                }
            }

            // Endereços que vão no convite: o aviso fica à vista, a lista só
            // quando pedida (com o convite aberto, a tela fica apertada).
            if root.show-invite && root.reach-text != "": Card {
                border-color: root.reach-warning ? Theme.warning : Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Endereços no convite"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                        Rectangle { }
                        Btn { height: 26px; font-size: 12px; text: root.show-addresses ? "Ocultar" : "Ver endereços"; clicked => { root.show-addresses = !root.show-addresses; } }
                    }
                    if root.reach-note != "": Text { text: root.reach-note; color: root.reach-warning ? Theme.warning : Theme.text-dim; wrap: word-wrap; font-size: 12px; }
                    if root.show-addresses: Text { text: root.reach-text; color: Theme.text-dim; wrap: word-wrap; font-family: "Cascadia Mono"; font-size: 12px; }
                }
            }

            if root.is-owner && root.show-invite: Card {
                HorizontalLayout {
                    padding: 14px;
                    spacing: 16px;
                    if root.invite-link == "": Rectangle {
                        width: 168px;
                        height: 168px;
                        background: Theme.surface-raised;
                        border-radius: 4px;
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: "Clique em \"Novo convite\" para gerar um link e o QR.";
                            color: Theme.text-dim;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // O QR fica em preto no branco: leitores de QR esperam isso.
                    if root.invite-link != "": Rectangle {
                        width: 168px;
                        height: 168px;
                        background: white;
                        border-radius: 4px;
                        Image { width: 160px; height: 160px; source: root.invite-qr; image-rendering: pixelated; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Text { text: "Convite"; color: Theme.text; font-weight: 600; }
                        Dim { text: "Uso único, válido por 24 h. Envie por um canal confiável."; }
                        Rectangle {
                            background: Theme.surface-raised;
                            border-radius: 6px;
                            min-height: 56px;
                            Text {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                height: parent.height - 16px;
                                text: root.invite-link;
                                color: Theme.text-dim;
                                font-family: "Cascadia Mono";
                                font-size: 11px;
                                wrap: char-wrap;
                                overflow: elide;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: "Copiar link"; primary: true; enabled: root.invite-link != ""; clicked => { root.copy-invite(); } }
                            Btn { text: "Novo convite"; clicked => { root.new-invite(); } }
                            Text { text: root.copy-status; color: Theme.success; vertical-alignment: center; }
                        }
                    }
                }
            }

            // Vídeo assistido: tela à esquerda, câmera à direita. Cada imagem é
            // uma janela-filha (D3D11) posta em cima da sua caixa; a UI não
            // desenha nada ali. Sem nada assistido, altura zero.
            Rectangle {
                property <bool> any: root.watching-label != "" || root.watching-cam-label != "";
                vertical-stretch: any ? 3 : 0;
                max-height: any ? 100000px : 0px;
                min-height: any ? 240px : 0px;
                background: Theme.surface;
                border-radius: 8px;
                border-width: any ? 1px : 0px;
                border-color: Theme.border;
                clip: true;
                HorizontalLayout {
                    visible: parent.any;
                    padding: 8px;
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: root.watching-label != "" ? 3 : 0;
                        max-width: root.watching-label != "" ? 100000px : 0px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Tela de " + root.watching-label; color: Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Rectangle { }
                            Btn { height: 28px; font-size: 12px; text: "Fechar"; clicked => { root.unwatch(); } }
                        }
                        video-box := Rectangle {
                            vertical-stretch: 1;
                            background: Theme.ink;
                            Text { text: "Aguardando a imagem…"; color: Theme.text-dim; }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: root.watching-cam-label != "" ? 1 : 0;
                        max-width: root.watching-cam-label != "" ? 100000px : 0px;
                        min-width: root.watching-cam-label != "" ? 220px : 0px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Câmera de " + root.watching-cam-label; color: Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; }
                            Rectangle { }
                            Btn { height: 28px; font-size: 12px; text: "Fechar"; clicked => { root.unwatch-camera(); } }
                        }
                        cam-box := Rectangle {
                            vertical-stretch: 1;
                            background: Theme.ink;
                            Text { text: "Aguardando a imagem…"; color: Theme.text-dim; }
                        }
                    }
                }
            }

            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 10px;
                    chat-sv := ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            spacing: 10px;
                            if root.chat.length == 0: Dim { text: "Nenhuma mensagem ainda. As mensagens são cifradas no seu PC; o servidor só repassa bytes."; }
                            for line in root.chat: VerticalLayout {
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text { text: line.who; color: line.mine ? Theme.violet-bright : Theme.text; font-weight: 600; }
                                    Text { text: line.time; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                                }
                                Text { text: line.text; color: Theme.text; wrap: word-wrap; }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Field {
                            text <=> root.chat-draft;
                            placeholder-text: root.admitted ? "Mensagem" : "aguardando admissão…";
                            enabled: root.admitted;
                            accepted => { root.send-chat(); }
                        }
                        Btn { text: "Enviar"; primary: true; enabled: root.admitted && root.chat-draft != ""; clicked => { root.send-chat(); } }
                    }
                }
            }
        }

        VerticalLayout {
            width: 280px;
            spacing: 12px;
            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    alignment: start;
                    Text { text: "Membros"; color: Theme.text; font-weight: 600; }
                    for m[i] in root.members: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { alignment: center; Presence { online: m.online; speaking: m.speaking; } }
                        VerticalLayout {
                            alignment: center;
                            Text { text: m.label; color: m.online ? Theme.text : Theme.text-dim; overflow: elide; }
                            if m.owner || m.waiting || m.in-voice || m.sharing || m.camera: Text {
                                text: (m.owner ? "dono" : m.waiting ? "aguardando admissão" : "")
                                    + (m.in-voice ? ((m.owner || m.waiting) ? " · " : "") + (m.speaking ? "falando" : "na voz") : "")
                                    + (m.sharing ? ((m.owner || m.waiting || m.in-voice) ? " · " : "") + "compartilhando" : "")
                                    + (m.camera ? ((m.owner || m.waiting || m.in-voice || m.sharing) ? " · " : "") + "câmera" : "");
                                color: m.speaking ? Theme.violet-bright : m.waiting ? Theme.warning : m.owner ? Theme.violet-bright : Theme.text-dim;
                                font-size: 11px;
                            }
                        }
                        Rectangle { }
                        if m.sharing && !m.me && root.watch-problem == "": Btn {
                            height: 26px;
                            font-size: 12px;
                            text: m.watching ? "Fechar" : "Assistir";
                            primary: !m.watching;
                            clicked => {
                                if (m.watching) { root.unwatch(); } else { root.watch-member(i); }
                            }
                        }
                        if m.camera && !m.me && root.watch-problem == "": Btn {
                            height: 26px;
                            font-size: 12px;
                            text: m.watching-camera ? "Fechar" : "Câmera";
                            primary: !m.watching-camera;
                            clicked => {
                                if (m.watching-camera) { root.unwatch-camera(); } else { root.watch-camera(i); }
                            }
                        }
                        if root.is-owner && !m.me && !m.waiting: Btn {
                            height: 26px;
                            font-size: 12px;
                            text: root.confirm-remove == i ? "Confirmar" : "Remover";
                            danger: true;
                            clicked => {
                                if (root.confirm-remove == i) { root.remove-member(i); root.confirm-remove = -1; } else { root.confirm-remove = i; }
                            }
                        }
                    }
                    if root.confirm-remove >= 0: VerticalLayout {
                        spacing: 6px;
                        Text {
                            text: "Remover troca a chave do grupo: a pessoa não lê mais nada daqui em diante e cai da sala.";
                            color: Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Btn { height: 26px; font-size: 12px; text: "Cancelar"; clicked => { root.confirm-remove = -1; } }
                        }
                    }
                }
            }
            // Detalhes técnicos da mídia ligada: dispositivos, codec, fps.
            if root.voice-devices != "" || root.screen-info != "" || root.camera-info != "": Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text { text: "Mídia"; color: Theme.text; font-weight: 600; }
                    if root.voice-devices != "": Dim { text: root.voice-devices; font-size: 12px; }
                    if root.screen-info != "": Dim { text: "Tela: " + root.screen-info; font-size: 12px; }
                    if root.camera-info != "": Dim { text: "Câmera: " + root.camera-info; font-size: 12px; }
                }
            }
            Card {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text { text: "Atividade"; color: Theme.text; font-weight: 600; }
                    ScrollView {
                        VerticalLayout {
                            alignment: start;
                            spacing: 4px;
                            for line in root.log: Text { text: line; color: Theme.text-dim; wrap: word-wrap; font-size: 12px; }
                        }
                    }
                }
            }
        }
    }

    // Barra de controle (SPEC-05 §4): voz · tela · câmera, sempre embaixo.
    // Cada estado tem texto, não só cor.
    Rectangle {
        background: Theme.surface;
        Rectangle { y: 0; height: 1px; background: Theme.border; }
        VerticalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if !root.voice-active: Btn {
                    text: "Entrar na voz";
                    primary: true;
                    enabled: root.admitted;
                    clicked => { root.join-voice(); }
                }
                if root.voice-active: Btn { text: root.voice-muted ? "Ativar mic" : "Mudo"; enabled: !root.voice-deafened; clicked => { root.toggle-mute(); } }
                if root.voice-active: Btn { text: root.voice-deafened ? "Ouvir" : "Ensurdecer"; clicked => { root.toggle-deafen(); } }
                if root.voice-active: Btn { text: "Sair da voz"; danger: true; clicked => { root.leave-voice(); } }

                Bar { }

                if !root.screen-sharing && root.monitors.length > 1: Picker {
                    width: 170px;
                    model: root.monitors;
                    current-index <=> root.monitor-index;
                }
                if !root.screen-sharing: Btn {
                    text: "Compartilhar tela";
                    primary: true;
                    enabled: root.admitted && root.can-share;
                    clicked => { root.share-screen(); }
                }
                if root.screen-sharing: Btn { text: "Parar a tela"; danger: true; clicked => { root.stop-screen(); } }

                Bar { }

                if !root.camera-on && root.cameras.length > 1: Picker {
                    width: 170px;
                    model: root.cameras;
                    current-index <=> root.camera-index;
                }
                if !root.camera-on: Btn {
                    text: root.cameras.length == 0 ? "Nenhuma câmera" : "Ligar câmera";
                    enabled: root.admitted && root.can-share && root.cameras.length > 0;
                    clicked => { root.start-camera(); }
                }
                if root.camera-on: Btn { text: "Desligar câmera"; danger: true; clicked => { root.stop-camera(); } }
            }
            HorizontalLayout {
                spacing: 16px;
                alignment: start;
                Text {
                    text: !root.voice-active ? "Voz: fora" : root.voice-deafened ? "Voz: ensurdecido" : root.voice-muted ? "Voz: mudo" : "Voz: conectado";
                    color: !root.voice-active ? Theme.text-dim : (root.voice-deafened || root.voice-muted) ? Theme.warning : Theme.success;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Check {
                    text: "Supressão forte de ruído";
                    checked <=> root.voice-strong-ns;
                    toggled => { root.strong-ns-changed(); }
                }
                if root.screen-sharing: Text {
                    text: "Tela no ar · " + (root.screen-watchers == 0 ? "ninguém assistindo" : root.screen-watchers == 1 ? "1 assistindo" : root.screen-watchers + " assistindo");
                    color: Theme.violet-bright;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.camera-on: Text {
                    text: "Câmera ligada · " + (root.camera-watchers == 0 ? "ninguém vendo" : root.camera-watchers == 1 ? "1 vendo" : root.camera-watchers + " vendo");
                    color: Theme.violet-bright;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                if root.watch-problem != "": Text {
                    text: "Para assistir: " + root.watch-problem;
                    color: Theme.warning;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}

struct ThirdParty {
    name: string,
    what: string,
    license: string,
}

// Sobre: versão, licenças de terceiros (SPEC-01 §9) e o que o app faz na rede.
component AboutView inherits VerticalLayout {
    in property <string> version;
    callback back();

    property <[ThirdParty]> libs: [
        { name: "Slint", what: "interface gráfica", license: "Licença Royalty-free do Slint 2.0" },
        { name: "iroh / quinn", what: "rede QUIC e travessia de NAT", license: "MIT ou Apache-2.0" },
        { name: "OpenMLS", what: "criptografia de grupo (MLS)", license: "MIT" },
        { name: "FFmpeg (avcodec, avutil, swresample)", what: "decodificação de vídeo; DLLs à parte, que você pode trocar", license: "LGPL 2.1 ou posterior" },
        { name: "Opus (porte em Rust)", what: "codec de voz", license: "BSD-3-Clause" },
        { name: "RNNoise (nnnoiseless)", what: "supressão forte de ruído", license: "BSD-3-Clause" },
        { name: "WebRTC Audio Processing (AEC3)", what: "cancelamento de eco, ruído e ganho", license: "MIT ou BSD-3-Clause" },
        { name: "Rust, tokio e demais crates", what: "base do programa", license: "MIT ou Apache-2.0" },
    ];

    padding: 24px;
    spacing: 16px;

    HorizontalLayout {
        spacing: 16px;
        Text { text: "Sobre o Lerri Chat"; color: Theme.text; font-size: 28px; font-weight: 600; vertical-alignment: center; }
        Rectangle { }
        VerticalLayout { alignment: center; Btn { text: "Voltar"; clicked => { root.back(); } } }
    }

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 16px;
            padding-right: 14px;
            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Title { text: "Versão " + root.version; }
                    Dim { text: "Voz, chat, tela e câmera entre amigos, cifrados de ponta a ponta. Sem conta e sem servidor de terceiros: só o seu PC, o dos seus amigos e, se você quiser, o seu próprio relay."; }
                }
            }
            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    Title { text: "Rede e firewall"; }
                    Dim { text: "Quem cria uma sala x1 ou roda um relay recebe conexões, e o Windows pode perguntar se o Lerri Chat pode usar a rede. Permita nas redes privadas, senão ninguém de fora consegue entrar. Quem só entra em salas não recebe conexões e não vê essa pergunta."; }
                    Dim { text: "O app só fala com o host da sala (o PC de quem criou ou o relay do convite) e com os outros membros. Nenhum STUN, relay ou serviço de terceiros."; }
                }
            }
            Card {
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    Title { text: "Software de terceiros"; }
                    for lib in root.libs: HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text { text: lib.name; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                            Dim { text: lib.what; font-size: 12px; }
                        }
                        Text { text: lib.license; color: Theme.text-dim; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; width: 220px; wrap: word-wrap; }
                    }
                }
            }
            Card {
                height: 170px;
                AboutSlint { }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Lerri Chat";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.ink;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    // "home", "busy", "room" ou "about".
    in-out property <string> screen: "home";
    in property <string> version;
    in property <string> busy-text;
    in-out property <string> error-text;

    in property <string> my-id;
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;

    in property <string> room-id;
    in property <string> room-info;
    in property <string> room-status;
    in property <string> route-text;
    in property <int> route-quality;
    in property <string> reach-text;
    in property <string> reach-note;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in property <string> watching-label;
    out property <length> video-x: room-view.video-x;
    out property <length> video-y: room-view.video-y;
    out property <length> video-width: room-view.video-width;
    out property <length> video-height: room-view.video-height;
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    in property <string> watching-cam-label;
    out property <length> cam-x: room-view.cam-x;
    out property <length> cam-y: room-view.cam-y;
    out property <length> cam-width: room-view.cam-width;
    out property <length> cam-height: room-view.cam-height;

    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch();
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera();
    callback scroll-chat-to-end();
    scroll-chat-to-end => { room-view.scroll-to-end(); }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        if root.error-text != "": Rectangle {
            background: Theme.danger-dim;
            border-width: 1px;
            border-color: Theme.danger;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text { text: root.error-text; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { horizontal-stretch: 0; text: "Fechar"; clicked => { root.error-text = ""; } }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            HomeView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "home";
                my-id: root.my-id;
                saved-rooms: root.saved-rooms;
                join-link <=> root.join-link;
                via-link <=> root.via-link;
                admin-link <=> root.admin-link;
                nickname <=> root.nickname;
                keep-history <=> root.keep-history;
                join => { root.join(); }
                create-x1 => { root.create-x1(); }
                create-server => { root.create-server(); }
                open-room(i) => { root.open-room(i); }
                save-settings => { root.save-settings(); }
                about => { root.screen = "about"; }
            }

            if root.screen == "about": AboutView {
                width: parent.width;
                height: parent.height;
                version: root.version;
                back => { root.screen = "home"; }
            }

            if root.screen == "busy": Text {
                width: parent.width;
                height: parent.height;
                text: root.busy-text;
                color: Theme.text-dim;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            room-view := RoomView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "room";
                room-id: root.room-id;
                room-info: root.room-info;
                room-status: root.room-status;
                route-text: root.route-text;
                route-quality: root.route-quality;
                reach-text: root.reach-text;
                reach-note: root.reach-note;
                reach-warning: root.reach-warning;
                is-owner: root.is-owner;
                show-invite <=> root.show-invite;
                invite-link: root.invite-link;
                invite-qr: root.invite-qr;
                copy-status: root.copy-status;
                chat: root.chat;
                chat-draft <=> root.chat-draft;
                members: root.members;
                log: root.log;
                voice-active: root.voice-active;
                voice-muted: root.voice-muted;
                voice-deafened: root.voice-deafened;
                voice-strong-ns <=> root.voice-strong-ns;
                voice-devices: root.voice-devices;
                screen-sharing: root.screen-sharing;
                screen-info: root.screen-info;
                screen-watchers: root.screen-watchers;
                can-share: root.can-share;
                watch-problem: root.watch-problem;
                monitors: root.monitors;
                monitor-index <=> root.monitor-index;
                watching-label: root.watching-label;
                camera-on: root.camera-on;
                camera-info: root.camera-info;
                camera-watchers: root.camera-watchers;
                cameras: root.cameras;
                camera-index <=> root.camera-index;
                watching-cam-label: root.watching-cam-label;
                join-voice => { root.join-voice(); }
                leave-voice => { root.leave-voice(); }
                toggle-mute => { root.toggle-mute(); }
                toggle-deafen => { root.toggle-deafen(); }
                strong-ns-changed => { root.strong-ns-changed(); }
                share-screen => { root.share-screen(); }
                stop-screen => { root.stop-screen(); }
                watch-member(i) => { root.watch-member(i); }
                unwatch => { root.unwatch(); }
                start-camera => { root.start-camera(); }
                stop-camera => { root.stop-camera(); }
                watch-camera(i) => { root.watch-camera(i); }
                unwatch-camera => { root.unwatch-camera(); }
                new-invite => { root.new-invite(); }
                copy-invite => { root.copy-invite(); }
                send-chat => { root.send-chat(); }
                remove-member(i) => { root.remove-member(i); }
                disconnect => { root.disconnect(); }
                leave-room => { root.leave-room(); }
            }
        }
    }
}
