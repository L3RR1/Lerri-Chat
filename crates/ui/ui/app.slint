// Interface (SPEC-05): início, espera, sala e "Sobre".
// Só tokens da paleta. Movimento só em mudança de estado (120-180 ms); o único
// laço é a barra de espera, que vive poucos segundos.

import { ScrollView, Palette, AboutSlint } from "std-widgets.slint";

// Hex do Color.kt do LerriNFC (P-01). Contraste conferido em tests/contrast.rs:
// todo par texto/fundo usado passa AA, menos text-mute (só desabilitado).
export global Theme {
    out property <color> ink: #0B0710;
    out property <color> surface: #150E1F;
    out property <color> surface-raised: #1C1329;
    out property <color> surface-hover: #271A38;
    out property <color> border: #342447;
    out property <color> violet: #B36BFF;
    out property <color> violet-bright: #CB9BFF;
    out property <color> violet-deep: #8E7BFF;
    out property <color> violet-glow: #B36BFF40;
    out property <color> violet-dim: #2E1A47;
    out property <color> violet-dim-hover: #3A2159;
    out property <color> on-violet: #1A0A2E;
    out property <color> text: #F2ECFB;
    out property <color> text-dim: #B4A3C9;
    out property <color> text-placeholder: #8E83A8;
    out property <color> text-mute: #766288;
    out property <color> success: #3DDC97;
    out property <color> warning: #FFB454;
    out property <color> danger: #FF5A6E;
    out property <color> success-dim: #0F3327;
    out property <color> warning-dim: #3A2A14;
    out property <color> danger-dim: #3A1620;
    // Cantos: controles 8, painéis 12, pílulas inteiras.
    out property <length> r-control: 8px;
    out property <length> r-panel: 12px;
}

export struct SavedRoomRow {
    id: string,
    label: string,
}

export struct ChatRow {
    who: string,
    initial: string,
    text: string,
    time: string,
    mine: bool,
    // Primeira de uma sequência da mesma pessoa: mostra avatar, nome e hora.
    first: bool,
}

export struct MemberRow {
    label: string,
    initial: string,
    online: bool,
    owner: bool,
    me: bool,
    waiting: bool,
    in-voice: bool,
    speaking: bool,
    sharing: bool,
    watching: bool,
    camera: bool,
    watching-camera: bool,
    // Ida e volta estimada até a pessoa, em ms; -1: ainda sem medida.
    latency: int,
    has-nick: bool,
}

// Um vídeo assistido na grade da sala. A posição (relativa à grade) vem do
// Rust, que também põe a janela-filha (D3D11) em cima da caixa preta.
export struct VideoTile {
    label: string,
    camera: bool,
    // A prévia da nossa câmera.
    own: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

// Ícones: Tabler Icons 3.47.0 (MIT, icons/LICENSE), traço de 2 px, rasterizados
// em PNG de 48 px (o SVG puxaria o resvg para o binário). O `colorize` pinta.
component Icon inherits Image {
    width: 18px;
    height: 18px;
    image-rendering: smooth;
}

// Botão: primário (roxo cheio, uma ação principal por área), tonal (roxo
// escuro), fantasma (contorno) ou perigo. Com ícone, texto ou os dois.
component Btn inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    // Nome para leitor de tela quando o botão é só ícone.
    in property <string> label: root.text;
    in property <bool> primary;
    in property <bool> tonal;
    in property <bool> danger;
    // Estado ligado de um botão de alternância (ex.: microfone mudo).
    in property <bool> on;
    in property <bool> enabled: true;
    in property <bool> compact;
    in property <bool> large;
    callback clicked;
    property <bool> has-icon: root.icon.width > 0;
    property <bool> has-text: root.text != "";
    property <color> fg: !root.enabled ? Theme.text-mute
        : root.primary ? Theme.on-violet
        : root.tonal ? Theme.violet-bright
        : root.danger ? Theme.danger
        : root.on ? Theme.warning
        : Theme.text;

    height: root.large ? 44px : root.compact ? 30px : 36px;
    min-width: root.has-text ? lay.preferred-width : root.height;
    border-radius: Theme.r-control;
    border-width: root.primary || root.tonal ? 0px : 1px;
    border-color: !root.enabled ? Theme.border
        : root.danger ? Theme.danger
        : root.on ? Theme.warning
        : ta.has-hover ? Theme.text-mute : Theme.border;
    background: !root.enabled ? (root.primary || root.tonal ? Theme.surface-raised : transparent)
        : root.primary ? (ta.pressed ? Theme.violet-deep : ta.has-hover ? Theme.violet-bright : Theme.violet)
        : root.tonal ? (ta.pressed ? Theme.violet-dim : ta.has-hover ? Theme.violet-dim-hover : Theme.violet-dim)
        : root.danger ? (ta.has-hover ? Theme.danger-dim : transparent)
        : root.on ? Theme.warning-dim
        : (ta.pressed ? Theme.surface-raised : ta.has-hover ? Theme.surface-hover : transparent);
    animate background, border-color { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) { root.clicked(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        // Foco só pelo teclado (Tab); o clique já age pelo TouchArea.
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    lay := HorizontalLayout {
        padding-left: root.has-text ? (root.compact ? 10px : 14px) : 0px;
        padding-right: root.has-text ? (root.compact ? 10px : 14px) : 0px;
        spacing: 8px;
        alignment: center;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                colorize: root.fg;
                width: root.compact ? 16px : 18px;
                height: root.compact ? 16px : 18px;
            }
        }
        if root.has-text: Text {
            text: root.text;
            font-size: root.compact ? 13px : 14px;
            font-weight: 600;
            color: root.fg;
            vertical-alignment: center;
        }
    }
    // Anel de foco do teclado (Tab); o clique do mouse não foca.
    if focus.has-focus && root.enabled: Rectangle {
        x: -3px;
        y: -3px;
        width: root.width + 6px;
        height: root.height + 6px;
        border-radius: Theme.r-control + 3px;
        border-width: 2px;
        border-color: Theme.violet-bright;
    }
}

component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.r-panel;
    border-width: 1px;
    border-color: Theme.border;
}

component Heading inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 600;
}

component Dim inherits Text {
    color: Theme.text-dim;
    wrap: word-wrap;
}

component Small inherits Text {
    color: Theme.text-dim;
    font-size: 12px;
    wrap: word-wrap;
}

// Rótulo de campo, sempre acima dele.
component FieldLabel inherits Text {
    color: Theme.text-dim;
    font-size: 13px;
    font-weight: 600;
}

component Dot inherits Rectangle {
    in property <color> tone;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone;
}

// Onda que sai do avatar de quem fala: um anel roxo que cresce e some. Existe
// só enquanto a pessoa fala, então parado nada redesenha (SPEC-05 §6).
component Ripple inherits Rectangle {
    in property <length> base;
    // Defasagem entre 0 e 1: duas ondas, uma no meio do caminho da outra.
    in property <float> offset;
    // Quadro do relógio da sala (30 fps, só enquanto alguém fala).
    in property <int> tick;
    property <float> phase: mod(root.tick / 36 + root.offset, 1);
    width: root.base + 20px * root.phase;
    height: self.width;
    border-radius: self.width / 2;
    border-width: 2px;
    border-color: Theme.violet-bright;
    opacity: 0.85 * (1 - root.phase);
}

// Forma de onda ao lado do nome de quem fala: barras roxas numa senoide
// que corre da esquerda para a direita.
component Waveform inherits HorizontalLayout {
    in property <bool> still;
    in property <int> tick;
    // Milissegundos de "tempo de onda" (o relógio anda a 30 fps).
    property <float> t: root.tick * 33;
    spacing: 2px;
    alignment: center;
    for i in 5: VerticalLayout {
        alignment: center;
        Rectangle {
            width: 3px;
            // Duas senoides somadas, defasadas por barra: parece fala, não metrônomo.
            height: root.still ? (i == 2 ? 14px : 9px)
                : 4px + 12px * (0.5 + 0.3 * sin((root.t / 260 - i * 0.9) * 1rad) + 0.2 * sin((root.t / 170 + i * 1.7) * 1rad));
            border-radius: 1.5px;
            background: Theme.violet-bright;
        }
    }
}

// Avatar com a inicial. Falando: ondas roxas saindo dele (ou um anel parado,
// com animações do Windows desligadas). O ponto no canto diz se está online.
component Avatar inherits Rectangle {
    in property <string> initial;
    in property <bool> me;
    in property <bool> online: true;
    in property <bool> speaking;
    in property <bool> still;
    in property <int> tick;
    in property <bool> show-presence;
    in property <length> size: 32px;
    width: root.size + 6px;
    height: root.size + 6px;
    border-radius: self.width / 2;
    border-width: root.speaking ? 2px : 0px;
    border-color: Theme.violet-bright;
    background: root.speaking ? Theme.violet-glow : transparent;
    if root.speaking && !root.still: Ripple { base: root.size + 6px; offset: 0; tick: root.tick; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; }
    if root.speaking && !root.still: Ripple { base: root.size + 6px; offset: 0.5; tick: root.tick; x: (root.width - self.width) / 2; y: (root.height - self.height) / 2; }
    Rectangle {
        width: root.size;
        height: root.size;
        border-radius: root.size / 2;
        background: root.me ? Theme.violet : Theme.violet-dim;
        Text {
            text: root.initial;
            color: root.me ? Theme.on-violet : Theme.violet-bright;
            font-size: root.size * 0.42;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if root.show-presence: Rectangle {
        x: parent.width - 13px;
        y: parent.height - 13px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.surface;
        Dot { tone: root.online ? Theme.success : Theme.text-mute; }
    }
}

// Campo de texto de uma linha com os tokens da paleta (o LineEdit padrão usa
// o azul de destaque do Fluent e o Palette não pode ser trocado). Rola o
// texto para manter o cursor à vista, como o LineEdit.
component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> large;
    in property <bool> mono;
    in property <InputType> input-type: InputType.text;
    callback accepted();
    callback edited();
    property <length> pad: 12px;
    property <length> scroll: 12px;

    public function focus-input() {
        input.focus();
    }

    height: root.large ? 44px : 36px;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.r-control;
    background: root.enabled ? Theme.surface-raised : Theme.surface;
    border-width: 1px;
    border-color: input.has-focus ? Theme.violet : ta.has-hover && root.enabled ? Theme.text-mute : Theme.border;
    animate border-color { duration: 120ms; }
    clip: true;
    accessible-role: text-input;
    accessible-label: root.label;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-enabled: root.enabled;
    // Leitores de tela e ditado escrevem no campo por aqui.
    accessible-action-set-value(value) => {
        if (root.enabled) {
            root.text = value;
            root.edited();
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    if root.text == "": Text {
        x: root.pad;
        width: parent.width - 2 * root.pad;
        height: parent.height;
        text: root.placeholder-text;
        color: root.enabled ? Theme.text-placeholder : Theme.text-mute;
        font-family: root.mono ? "Cascadia Mono" : "";
        font-size: root.mono ? 13px : 14px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: min(root.pad, max(parent.width - self.width - root.pad, root.scroll));
        width: max(parent.width - 2 * root.pad, self.preferred-width);
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        input-type: root.input-type;
        single-line: true;
        vertical-alignment: center;
        font-family: root.mono ? "Cascadia Mono" : "";
        font-size: root.mono ? 13px : 14px;
        color: root.enabled ? Theme.text : Theme.text-mute;
        selection-background-color: Theme.violet-dim-hover;
        selection-foreground-color: Theme.text;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
        cursor-position-changed(pos) => {
            if (pos.x + root.scroll < root.pad) {
                root.scroll = root.pad - pos.x;
            } else if (pos.x + root.scroll > root.width - 2 * root.pad - 2px) {
                root.scroll = root.width - root.pad - pos.x - 2px;
            }
        }
    }
}

// Caixa de seleção: quadrado com o visto em roxo quando marcada, mais o texto.
component Check inherits Rectangle {
    in property <string> text;
    in property <bool> small;
    in-out property <bool> checked;
    callback toggled();

    min-height: root.small ? 26px : 32px;
    min-width: label.preferred-width + 28px;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { root.flip(); }

    function flip() {
        root.checked = !root.checked;
        root.toggled();
    }

    focus := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.flip();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
    box := Rectangle {
        x: 0px;
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border-width: root.checked ? 0px : 1px;
        border-color: ta.has-hover || focus.has-focus ? Theme.violet : Theme.text-mute;
        background: root.checked ? Theme.violet : Theme.surface-raised;
        animate background { duration: 120ms; }
        if root.checked: Icon {
            source: @image-url("icons/check.png");
            colorize: Theme.on-violet;
            width: 14px;
            height: 14px;
        }
    }
    if focus.has-focus: Rectangle {
        x: box.x - 3px;
        width: box.width + 6px;
        height: box.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.violet-bright;
    }
    label := Text {
        x: 28px;
        width: parent.width - 28px;
        height: parent.height;
        text: root.text;
        color: root.small ? Theme.text-dim : Theme.text;
        font-size: root.small ? 13px : 14px;
        vertical-alignment: center;
    }
}

// Escolha entre poucas opções na mesma área (abas).
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    // Controlado: quem usa decide o índice a partir de `changed` (o estado
    // vem de fora, ex.: gravação de tecla que pode ser cancelada).
    in property <bool> controlled;
    callback changed(int);
    height: 38px;
    border-radius: Theme.r-control;
    background: Theme.ink;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: tab-list;
    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for option[i] in root.options: Rectangle {
            border-radius: Theme.r-control - 2px;
            background: i == root.index ? Theme.surface-hover : sta.has-hover ? Theme.surface-raised : transparent;
            animate background { duration: 150ms; }
            accessible-role: tab;
            accessible-label: option;
            accessible-item-selected: i == root.index;
            accessible-action-default => { root.pick(i); }
            Text {
                text: option;
                color: i == root.index ? Theme.text : Theme.text-dim;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            sta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.pick(i); }
            }
        }
    }

    function pick(i: int) {
        if (!root.controlled) { root.index = i; }
        root.changed(i);
    }
}

// Botão de seta ao lado de "Compartilhar tela"/"Ligar câmera": escolhe o
// monitor ou a câmera. Fica na barra de baixo, então a lista abre para cima.
component DeviceMenu inherits Rectangle {
    in property <[string]> model;
    in property <string> title;
    in-out property <int> current-index;
    // Antes de abrir: quem usa pode atualizar a lista (ex.: janelas abertas).
    callback opened();
    property <length> item-height: 34px;

    width: 36px;
    height: 36px;
    Btn {
        width: 100%;
        icon: @image-url("icons/chevron-up.png");
        label: root.title + ": " + root.model[root.current-index];
        clicked => {
            root.opened();
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0px;
        y: -(root.model.length * (root.item-height + 2px) + 46px);
        width: 340px;
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.r-control + 2px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                Text {
                    height: 28px;
                    text: root.title;
                    color: Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    x: 8px;
                }
                for item[i] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 6px;
                    background: ita.has-hover ? Theme.surface-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            width: 16px;
                            if i == root.current-index: Icon {
                                source: @image-url("icons/check.png");
                                colorize: Theme.violet-bright;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        Text {
                            text: item;
                            color: i == root.current-index ? Theme.violet-bright : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    accessible-role: list-item;
                    accessible-label: item;
                    accessible-item-selected: i == root.current-index;
                    accessible-action-default => { root.current-index = i; }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.current-index = i; }
                    }
                }
            }
        }
    }
}

// Lista suspensa no estilo dos campos (o ComboBox do std-widgets usa o azul
// do Fluent). Abre para baixo.
component Select inherits Rectangle {
    in property <[string]> model;
    in property <string> label;
    in-out property <int> current-index;
    callback selected(int);
    property <length> item-height: 34px;

    height: 36px;
    min-width: 120px;
    horizontal-stretch: 1;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.text-mute : Theme.border;
    background: Theme.surface-raised;
    accessible-role: combobox;
    accessible-label: root.label;
    accessible-value: root.model[root.current-index];
    accessible-expandable: true;
    accessible-action-default => { popup.show(); }
    accessible-action-expand => { popup.show(); }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { popup.show(); }
    }
    Text {
        x: 12px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.model[root.current-index];
        color: Theme.text;
        vertical-alignment: center;
        overflow: elide;
    }
    Icon {
        x: parent.width - 28px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        source: @image-url("icons/chevron-down.png");
        colorize: Theme.text-dim;
    }
    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.r-control + 2px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for item[i] in root.model: Rectangle {
                    height: root.item-height;
                    border-radius: 6px;
                    background: ita.has-hover ? Theme.surface-hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            width: 16px;
                            if i == root.current-index: Icon {
                                source: @image-url("icons/check.png");
                                colorize: Theme.violet-bright;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        Text {
                            text: item;
                            color: i == root.current-index ? Theme.violet-bright : Theme.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    accessible-role: list-item;
                    accessible-label: item;
                    accessible-item-selected: i == root.current-index;
                    accessible-action-default => {
                        root.current-index = i;
                        root.selected(i);
                    }
                    ita := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// Faixa de aviso dentro da tela (erro, espera, confirmação).
component Banner inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.warning;
    in property <color> tone-dim: Theme.warning-dim;
    in property <image> icon: @image-url("icons/alert-triangle.png");
    background: root.tone-dim;
    border-radius: Theme.r-control;
    border-width: 1px;
    border-color: root.tone;
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout { alignment: start; padding-top: 1px; Icon { source: root.icon; colorize: root.tone; } }
        Text {
            text: root.text;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

// Barra do topo das telas sem sala: marca à esquerda, ações à direita.
component TopBar inherits Rectangle {
    height: 56px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        @children
    }
}

// Linha fina que separa blocos sem fechá-los numa caixa.
component Rule inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// Uma coluna só: entrar com o convite lidera; criar fica embaixo, e o raro
// (servidor, ponto de encontro) só aparece quando pedido.
component HomeView inherits VerticalLayout {
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;
    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();
    callback about();

    property <bool> show-via: root.via-link != "";
    property <bool> show-server;

    TopBar {
        Text { text: "Lerri Chat"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
        Rectangle { }
        VerticalLayout {
            alignment: center;
            Btn { text: "Sobre"; icon: @image-url("icons/info-circle.png"); compact: true; clicked => { root.about(); } }
        }
    }

    // Rola só quando a janela fica baixa.
    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            min-height: parent.visible-height;
            alignment: center;
            HorizontalLayout {
                padding: 32px;
                alignment: center;
                VerticalLayout {
                    width: 520px;
                    spacing: 36px;

                    // Quem recebeu um convite: a tarefa mais comum.
                    VerticalLayout {
                        spacing: 10px;
                        Text { text: "Entrar numa sala"; color: Theme.text; font-size: 26px; font-weight: 600; }
                        Dim { text: "Cole o convite que te mandaram. Cada um serve para uma pessoa e vale por 24 horas."; }
                        HorizontalLayout {
                            spacing: 10px;
                            padding-top: 6px;
                            Field {
                                large: true;
                                mono: true;
                                label: "Convite";
                                text <=> root.join-link;
                                placeholder-text: "lerrichat://join?…";
                                accepted => { if (root.join-link != "") { root.join(); } }
                            }
                            Btn { text: "Entrar"; primary: true; large: true; enabled: root.join-link != ""; clicked => { root.join(); } }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            padding-top: 6px;
                            VerticalLayout {
                                alignment: center;
                                FieldLabel { text: "Seu apelido"; }
                            }
                            Field {
                                label: "Apelido";
                                text <=> root.nickname;
                                placeholder-text: "Como a sala vai te chamar (opcional)";
                                edited => { root.save-settings(); }
                            }
                        }
                    }

                    Rule { }

                    // Criar: as duas formas lado a lado; os campos só quando pedidos.
                    VerticalLayout {
                        spacing: 10px;
                        Text { text: "Criar uma sala"; color: Theme.text; font-size: 18px; font-weight: 600; }
                        Dim { text: "Direto deste PC para conversar a dois, ou no seu servidor para 3 ou mais pessoas."; }
                        HorizontalLayout {
                            spacing: 10px;
                            padding-top: 6px;
                            alignment: start;
                            Btn { text: "Criar sala x1"; tonal: true; icon: @image-url("icons/device-desktop.png"); clicked => { root.create-x1(); } }
                            Btn {
                                text: "No meu servidor";
                                icon: @image-url("icons/users.png");
                                clicked => { root.show-server = !root.show-server; }
                            }
                        }
                        if root.show-server: VerticalLayout {
                            spacing: 6px;
                            padding-top: 6px;
                            FieldLabel { text: "Link de administração do servidor"; }
                            HorizontalLayout {
                                spacing: 10px;
                                Field {
                                    mono: true;
                                    label: "Link de administração do servidor";
                                    text <=> root.admin-link;
                                    placeholder-text: "lerrichat://admin?…";
                                    input-type: password;
                                    accepted => { if (root.admin-link != "") { root.create-server(); } }
                                }
                                Btn { text: "Criar"; tonal: true; enabled: root.admin-link != ""; clicked => { root.create-server(); } }
                            }
                            Small { text: "O lerrichat-host mostra esse link quando inicia. Guarde como uma senha."; }
                        }
                        Small { text: "Na sala x1, o Windows pode perguntar se o Lerri Chat pode usar a rede. Permita, senão ninguém de fora consegue entrar."; }
                        HorizontalLayout {
                            alignment: start;
                            Btn {
                                compact: true;
                                text: root.show-via ? "Ocultar ponto de encontro" : "Ponto de encontro (opcional)";
                                icon: root.show-via ? @image-url("icons/chevron-up.png") : @image-url("icons/chevron-down.png");
                                clicked => { root.show-via = !root.show-via; }
                            }
                        }
                        if root.show-via: VerticalLayout {
                            spacing: 6px;
                            Field {
                                mono: true;
                                label: "Link público do seu relay";
                                text <=> root.via-link;
                                placeholder-text: "lerrichat://relay?…";
                            }
                            Small { text: "Com o link público do seu relay, os dois PCs se acham mesmo atrás de roteadores difíceis. A conversa continua direta."; }
                        }
                    }

                    // Só existe quando há para onde voltar.
                    if root.saved-rooms.length > 0: VerticalLayout {
                        spacing: 4px;
                        Text { text: "Minhas salas"; color: Theme.text; font-size: 15px; font-weight: 600; }
                        for room[i] in root.saved-rooms: Rectangle {
                            height: 48px;
                            border-radius: Theme.r-control;
                            background: rta.has-hover ? Theme.surface-hover : transparent;
                            animate background { duration: 120ms; }
                            rta := TouchArea { mouse-cursor: pointer; clicked => { root.open-room(i); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { source: @image-url("icons/users.png"); colorize: Theme.violet-bright; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: room.label != "" ? room.label : room.id; color: Theme.text; overflow: elide; }
                                    if room.label != "": Text { text: room.id; color: Theme.text-dim; font-family: "Cascadia Mono"; font-size: 12px; overflow: elide; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Btn { text: "Abrir"; compact: true; label: "Abrir sala " + room.id; clicked => { root.open-room(i); } }
                                }
                            }
                        }
                    }

                    Check {
                        text: "Guardar o histórico do chat neste PC";
                        small: true;
                        checked <=> root.keep-history;
                        toggled => { root.save-settings(); }
                    }
                }
            }
        }
    }
}

component BusyView inherits Rectangle {
    in property <string> text;
    property <bool> run;
    init => { root.run = true; }
    VerticalLayout {
        alignment: center;
        spacing: 20px;
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 16px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 200px;
                height: 4px;
                border-radius: 2px;
                background: Theme.surface-raised;
                clip: true;
                accessible-role: progress-indicator;
                accessible-label: root.text;
                Rectangle {
                    width: 64px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.violet;
                    x: root.run ? parent.width - self.width : 0px;
                    animate x { duration: 900ms; easing: ease-in-out; iteration-count: -1; direction: alternate; }
                }
            }
        }
    }
}

// Cabeçalho do painel lateral: título e, fora da lista de membros, fechar.
component SideHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    in property <bool> closable;
    callback close();
    spacing: 8px;
    height: 36px;
    Heading { text: root.title; vertical-alignment: center; }
    if root.count != "": Text { text: root.count; color: Theme.text-dim; vertical-alignment: center; }
    Rectangle { }
    if root.closable: VerticalLayout {
        alignment: center;
        Btn { compact: true; icon: @image-url("icons/x.png"); label: "Fechar " + root.title; clicked => { root.close(); } }
    }
}

component RoomView inherits VerticalLayout {
    in property <string> room-id;
    in property <string> room-kind;
    in property <string> room-info;
    in property <bool> is-x1;
    in property <string> room-status;
    in property <string> route-text;
    // 0: bom, 1: atenção (latência alta ou pelo ponto de encontro), 2: ruim.
    in property <int> route-quality;
    in property <string> reach-text;
    in property <string> reach-note;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <bool> copy-ok;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    // Voz e áudio: listas com "Padrão do Windows" no índice 0.
    in property <[string]> audio-inputs: ["Padrão do Windows"];
    in property <[string]> audio-outputs: ["Padrão do Windows"];
    in-out property <int> input-index;
    in-out property <int> output-index;
    // Apertar para falar: nome da tecla; vazio = detecção de voz.
    in property <string> ptt-key;
    in property <bool> ptt-capturing;
    in property <bool> me-speaking;
    callback audio-settings-opened();
    callback input-changed(int);
    callback output-changed(int);
    callback ptt-mode(bool);
    callback change-ptt-key();
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    // Tela: a nossa e a que assistimos.
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    // Quantos recebem a camada baixa do simulcast (rede ruim).
    in property <int> screen-low-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    // As primeiras `monitor-count` opções do menu são telas; o resto, janelas.
    in property <int> monitor-count;
    callback share-menu-opened();
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch-member(int);
    // Câmera: a nossa e a que assistimos.
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera(int);
    // Vídeos assistidos (telas e câmeras juntas), em grade.
    in property <[VideoTile]> tiles;
    in property <int> max-tiles: 4;
    // A prévia da nossa câmera está na grade (fora do limite acima).
    in property <bool> preview-on;
    property <bool> grid-full: root.tiles.length - (root.preview-on ? 1 : 0) >= root.max-tiles;
    callback close-tile(int);
    callback toggle-preview();
    // Apelido, trocado direto na lista de membros.
    in property <string> nickname;
    callback set-nickname(string);
    property <bool> editing-nick;
    property <string> nick-draft;
    // Área da grade, em pixels lógicos: o Rust divide em células e põe as
    // janelas de vídeo (filhas, D3D11) em cima delas.
    out property <length> stage-x: stage.absolute-position.x;
    out property <length> stage-y: stage.absolute-position.y;
    out property <length> stage-width: stage.width;
    out property <length> stage-height: stage.height;

    property <bool> confirm-leave;
    property <int> confirm-remove: -1;
    property <bool> show-addresses;
    property <bool> show-audio;
    property <bool> admitted: root.room-status == "";
    // O painel lateral mostra uma coisa por vez: voz e áudio, convite ou a sala.
    property <bool> side-audio: root.show-audio;
    property <bool> side-invite: !root.show-audio && root.is-owner && root.show-invite;
    in property <bool> narrow;
    // "Efeitos de animação" desligados no Windows: ondas viram anel parado.
    in property <bool> reduce-motion;
    // Alguém falando agora: liga o relógio das ondas.
    in property <bool> anyone-speaking;
    property <int> wave-tick;
    // Um relógio só para todas as ondas, a 30 fps (SPEC-05 §6): a 165 Hz do
    // monitor, o renderer software gastaria quase meio núcleo.
    Timer {
        interval: 33ms;
        running: root.anyone-speaking && !root.reduce-motion;
        triggered => { root.wave-tick += 1; }
    }

    public function scroll-to-end() {
        chat-sv.content-y = min(0px, chat-sv.visible-height - chat-sv.content-height);
    }

    // Topo: o que é esta sala, numa linha de estado, e como sair.
    Rectangle {
        height: 60px;
        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 3px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text { text: root.room-kind; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                    Text { text: root.room-id; color: Theme.text-dim; font-family: "Cascadia Mono"; font-size: 12px; vertical-alignment: center; }
                }
                // Cifragem, caminho de rede e papel numa linha só; a cor do
                // ponto acompanha a qualidade e o texto diz o caminho.
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    VerticalLayout { alignment: center; Icon { source: @image-url("icons/lock.png"); colorize: Theme.success; width: 13px; height: 13px; } }
                    Text { text: "Cifrada"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    Text { text: "·"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Dot { tone: root.route-text == "" ? Theme.text-mute : root.route-quality == 0 ? Theme.success : root.route-quality == 1 ? Theme.warning : Theme.danger; }
                    }
                    Text {
                        text: root.route-text == "" ? "Sem conexão" : root.route-text;
                        color: root.route-text == "" || root.route-quality == 0 ? Theme.text-dim : root.route-quality == 1 ? Theme.warning : Theme.danger;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    if root.room-info != "": Text { text: "·"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                    Text { text: root.room-info; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
                }
            }
            if root.is-owner: VerticalLayout {
                alignment: center;
                Btn {
                    text: "Convidar";
                    icon: @image-url("icons/user-plus.png");
                    tonal: !root.side-invite;
                    clicked => {
                        root.show-audio = false;
                        root.show-invite = !root.side-invite;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                // Na x1 a sala vive no PC do dono: sair dela é encerrá-la.
                Btn {
                    text: root.is-x1 && root.is-owner ? "Encerrar sala" : "Desconectar";
                    icon: @image-url("icons/plug-connected-x.png");
                    clicked => { root.disconnect(); }
                }
            }
            if !root.is-owner: VerticalLayout {
                alignment: center;
                Btn {
                    text: root.narrow ? "" : "Sair da sala";
                    label: "Sair da sala";
                    icon: @image-url("icons/door-exit.png");
                    danger: true;
                    clicked => { root.confirm-leave = !root.confirm-leave; }
                }
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;

        // Coluna principal: avisos, vídeos assistidos e a conversa.
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 16px;
            padding-left: 20px;
            spacing: 12px;

            if root.confirm-leave && !root.is-owner: Banner {
                tone: Theme.danger;
                tone-dim: Theme.danger-dim;
                icon: @image-url("icons/door-exit.png");
                text: "Sair de vez apaga a sala deste PC. Para voltar, você vai precisar de um convite novo.";
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        Btn { text: "Cancelar"; compact: true; clicked => { root.confirm-leave = false; } }
                        Btn { text: "Sair de vez"; compact: true; danger: true; clicked => { root.leave-room(); } }
                    }
                }
            }

            if root.room-status != "": Banner { text: root.room-status; }

            // Vídeos assistidos, em grade (telas e câmeras juntas). Cada imagem
            // é uma janela-filha (D3D11) que o Rust põe em cima da caixa preta
            // da célula; a UI não desenha nada ali. Sem nada, altura zero.
            Rectangle {
                property <bool> any: root.tiles.length > 0;
                vertical-stretch: any ? 3 : 0;
                max-height: any ? 100000px : 0px;
                // Sem isto a grade vazia limita a largura da coluna inteira e
                // sobra uma faixa à direita da sala.
                max-width: 100000px;
                min-height: !any ? 0px : root.tiles.length > 2 ? 380px : 240px;
                clip: true;
                stage := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    for t[i] in root.tiles: Rectangle {
                        x: t.x;
                        y: t.y;
                        width: t.width;
                        height: t.height;
                        // 30 px de cabeçalho + 8 de espaço: o Rust põe o vídeo
                        // logo abaixo (HEADER em video.rs).
                        HorizontalLayout {
                            y: 0px;
                            height: 30px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Icon {
                                    source: t.camera ? @image-url("icons/video.png") : @image-url("icons/screen-share.png");
                                    colorize: Theme.violet-bright;
                                    width: 16px;
                                    height: 16px;
                                }
                            }
                            Text {
                                text: t.own ? "Sua câmera" : (t.camera ? "Câmera de " : "Tela de ") + t.label;
                                color: Theme.text;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if t.own: Text {
                                text: "espelhada só para você";
                                color: Theme.text-dim;
                                font-size: 12px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Btn {
                                compact: true;
                                icon: @image-url("icons/x.png");
                                label: t.own ? "Esconder sua câmera" : "Fechar " + (t.camera ? "câmera de " : "tela de ") + t.label;
                                clicked => { root.close-tile(i); }
                            }
                        }
                        Rectangle {
                            y: 38px;
                            width: parent.width;
                            height: max(0px, parent.height - 38px);
                            background: Theme.surface;
                            border-radius: Theme.r-control;
                            Text { text: t.own ? "Ligando a câmera…" : "Aguardando a imagem…"; color: Theme.text-dim; }
                        }
                    }
                }
            }

            // A conversa: sem moldura, ocupa o que sobra da coluna.
            chat-panel := VerticalLayout {
                vertical-stretch: 1;
                min-height: 140px;
                Rectangle {
                    vertical-stretch: 1;
                    chat-sv := ScrollView {
                        width: parent.width;
                        height: parent.height;
                        VerticalLayout {
                            alignment: start;
                            padding-bottom: 8px;
                            spacing: 4px;
                            for line in root.chat: HorizontalLayout {
                                spacing: 12px;
                                padding-top: line.first ? 12px : 0px;
                                VerticalLayout {
                                    alignment: start;
                                    width: 38px;
                                    if line.first: Avatar { initial: line.initial; me: line.mine; size: 32px; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    if line.first: HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: line.who; color: line.mine ? Theme.violet-bright : Theme.text; font-weight: 600; vertical-alignment: center; }
                                        Text { text: line.time; color: Theme.text-dim; font-size: 12px; vertical-alignment: center; }
                                    }
                                    Text { text: line.text; color: Theme.text; wrap: word-wrap; }
                                }
                            }
                        }
                    }
                    // Sala vazia: o próximo passo (chamar alguém) e por que é seguro.
                    if root.chat.length == 0 && self.height > 180px: VerticalLayout {
                        property <bool> alone: root.members.length <= 1;
                        width: parent.width;
                        height: parent.height;
                        alignment: center;
                        spacing: 8px;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                source: alone ? @image-url("icons/user-plus.png") : @image-url("icons/message-circle.png");
                                colorize: Theme.violet-bright;
                                width: 28px;
                                height: 28px;
                            }
                        }
                        Text {
                            text: alone ? "Só você por aqui, por enquanto" : "A conversa começa aqui";
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            alignment: center;
                            Dim {
                                max-width: 400px;
                                text: !alone ? "As mensagens são cifradas no seu PC. Quem hospeda a sala só repassa bytes que não consegue ler."
                                    : root.is-owner ? "Mande um convite para quem você quer chamar. Cada convite serve para uma pessoa e vale por 24 horas."
                                    : "Quando outras pessoas entrarem, elas aparecem na lista ao lado.";
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }
                        if alone && root.is-owner && !root.side-invite: HorizontalLayout {
                            alignment: center;
                            padding-top: 6px;
                            Btn {
                                text: "Convidar alguém";
                                icon: @image-url("icons/user-plus.png");
                                primary: true;
                                clicked => {
                                    root.show-audio = false;
                                    root.show-invite = true;
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 8px;
                    spacing: 10px;
                    Field {
                        large: true;
                        label: "Mensagem";
                        text <=> root.chat-draft;
                        placeholder-text: root.admitted ? "Escreva uma mensagem" : "Aguardando o dono te admitir…";
                        enabled: root.admitted;
                        accepted => { root.send-chat(); }
                    }
                    Btn { icon: @image-url("icons/send.png"); label: "Enviar"; primary: true; large: true; width: 44px; enabled: root.admitted && root.chat-draft != ""; clicked => { root.send-chat(); } }
                }
            }
        }

        // Painel lateral de contexto: a sala (membros e atividade), o convite
        // ou voz e áudio, um por vez. Nunca empurra a conversa nem a barra.
        Rectangle {
            width: 300px;
            background: Theme.surface;
            Rectangle { x: 0; width: 1px; background: Theme.border; }

            // Rola quando a janela fica baixa.
            if root.side-audio: ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 16px;
                    spacing: 16px;
                    alignment: start;
                    SideHeader { title: "Voz e áudio"; closable: true; close => { root.show-audio = false; } }
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "Microfone"; }
                        Select {
                            label: "Microfone";
                            model: root.audio-inputs;
                            current-index <=> root.input-index;
                            selected(i) => { root.input-changed(i); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "Saída"; }
                        Select {
                            label: "Saída de áudio";
                            model: root.audio-outputs;
                            current-index <=> root.output-index;
                            selected(i) => { root.output-changed(i); }
                        }
                    }
                    VerticalLayout {
                        spacing: 6px;
                        FieldLabel { text: "Transmitir"; }
                        Segmented {
                            options: ["Ao falar", "Com uma tecla"];
                            controlled: true;
                            index: root.ptt-key != "" || root.ptt-capturing ? 1 : 0;
                            changed(i) => { root.ptt-mode(i == 1); }
                        }
                    }
                    if root.ptt-key != "" || root.ptt-capturing: HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.ptt-capturing ? "Aperte a tecla ou o botão do mouse (Esc cancela)" : root.ptt-key;
                                color: root.ptt-capturing ? Theme.violet-bright : Theme.text;
                                font-weight: root.ptt-capturing ? 400 : 600;
                                wrap: word-wrap;
                            }
                            if !root.ptt-capturing: Small { text: "Segure para falar, mesmo com o jogo em foco."; }
                        }
                        VerticalLayout {
                            alignment: center;
                            Btn { compact: true; text: "Mudar"; label: "Mudar tecla"; enabled: !root.ptt-capturing; clicked => { root.change-ptt-key(); } }
                        }
                    }
                    Check {
                        small: true;
                        text: "Supressão forte de ruído";
                        checked <=> root.voice-strong-ns;
                        toggled => { root.strong-ns-changed(); }
                    }
                    // Detalhes técnicos da mídia ligada: dispositivos, codec, fps.
                    if root.voice-devices != "" || root.screen-info != "" || root.camera-info != "": VerticalLayout {
                        spacing: 4px;
                        Rule { }
                        if root.voice-devices != "": Small { text: root.voice-devices; }
                        if root.screen-info != "": Small { text: "Tela: " + root.screen-info; }
                        if root.camera-info != "": Small { text: "Câmera: " + root.camera-info; }
                    }
                }
            }

            // Rola quando a janela fica baixa.
            if root.side-invite: ScrollView {
                width: parent.width;
                height: parent.height;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;
                    alignment: start;
                    SideHeader { title: "Convidar"; closable: true; close => { root.show-invite = false; } }
                    // O QR fica em preto no branco: leitores de QR esperam isso.
                    HorizontalLayout {
                        alignment: center;
                        if root.invite-link != "": Rectangle {
                            width: 168px;
                            height: 168px;
                            background: white;
                            border-radius: Theme.r-control;
                            Image { width: 156px; height: 156px; source: root.invite-qr; image-rendering: pixelated; }
                        }
                    }
                    Dim { text: "Cada convite serve para uma pessoa e vale por 24 horas. Mande por um canal em que você confia."; font-size: 13px; }
                    if root.invite-link != "": Rectangle {
                        background: Theme.ink;
                        border-radius: Theme.r-control;
                        border-width: 1px;
                        border-color: Theme.border;
                        height: 36px;
                        Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: root.invite-link;
                            color: Theme.text-dim;
                            font-family: "Cascadia Mono";
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        if root.invite-link != "": Btn { text: "Copiar"; label: "Copiar convite"; icon: @image-url("icons/copy.png"); primary: true; horizontal-stretch: 1; clicked => { root.copy-invite(); } }
                        Btn { text: root.invite-link == "" ? "Gerar convite" : "Gerar outro"; icon: @image-url("icons/refresh.png"); horizontal-stretch: 1; tonal: root.invite-link == ""; clicked => { root.new-invite(); } }
                    }
                    if root.copy-status != "": HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: root.copy-ok ? @image-url("icons/check.png") : @image-url("icons/alert-triangle.png");
                                colorize: root.copy-ok ? Theme.success : Theme.danger;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text { text: root.copy-status; color: root.copy-ok ? Theme.success : Theme.danger; font-size: 12px; vertical-alignment: center; }
                    }
                    // Endereços que vão no convite: o aviso fica à vista, a lista só quando pedida.
                    if root.reach-text != "": VerticalLayout {
                        spacing: 8px;
                        Rule { }
                        Text {
                            text: root.reach-note != "" ? root.reach-note : "Endereços deste PC que vão no convite.";
                            color: root.reach-warning ? Theme.warning : Theme.text-dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            alignment: start;
                            Btn { compact: true; text: root.show-addresses ? "Ocultar endereços" : "Ver endereços"; clicked => { root.show-addresses = !root.show-addresses; } }
                        }
                        if root.show-addresses: Text { text: root.reach-text; color: Theme.text-dim; wrap: word-wrap; font-family: "Cascadia Mono"; font-size: 12px; }
                    }
                }
            }

            if !root.side-audio && !root.side-invite: VerticalLayout {
                padding: 16px;
                padding-right: 6px;
                spacing: 10px;
                SideHeader { title: "Na sala"; count: root.members.length; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        padding-right: 10px;
                        for m[i] in root.members: VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                spacing: 10px;
                                VerticalLayout {
                                    alignment: center;
                                    Avatar { initial: m.initial; me: m.me; online: m.online; speaking: m.speaking; still: root.reduce-motion; tick: root.wave-tick; show-presence: true; size: 32px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    horizontal-stretch: 1;
                                    Text { text: m.label; color: m.online ? Theme.text : Theme.text-dim; overflow: elide; }
                                    if m.owner || m.waiting || m.in-voice || m.sharing || m.camera: Text {
                                        text: (m.owner ? "dono" : m.waiting ? "aguardando admissão" : "")
                                            + (m.in-voice ? ((m.owner || m.waiting) ? ", " : "") + (m.speaking ? "falando" : "na voz") : "")
                                            + (m.sharing ? ((m.owner || m.waiting || m.in-voice) ? ", " : "") + "mostrando a tela" : "")
                                            + (m.camera ? ((m.owner || m.waiting || m.in-voice || m.sharing) ? ", " : "") + "câmera ligada" : "");
                                        color: m.speaking ? Theme.violet-bright : m.waiting ? Theme.warning : Theme.text-dim;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                                // Latência até a pessoa (a sua aparece no topo, no caminho de rede).
                                if !m.me && m.latency >= 0: Text {
                                    text: m.latency + " ms";
                                    color: m.latency < 120 ? Theme.text-dim : m.latency < 300 ? Theme.warning : Theme.danger;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    accessible-role: text;
                                    accessible-label: "Latência até " + m.label + ": " + m.latency + " milissegundos";
                                }
                                if m.speaking: Waveform { still: root.reduce-motion; tick: root.wave-tick; }
                            }
                            // O seu apelido: troca ali mesmo, sem sair da sala.
                            if m.me && !root.editing-nick: HorizontalLayout {
                                alignment: start;
                                padding-left: 48px;
                                Btn {
                                    compact: true;
                                    text: m.has-nick ? "Mudar apelido" : "Escolher apelido";
                                    tonal: !m.has-nick;
                                    clicked => {
                                        root.nick-draft = root.nickname;
                                        root.editing-nick = true;
                                    }
                                }
                            }
                            if m.me && root.editing-nick: VerticalLayout {
                                spacing: 6px;
                                padding-left: 48px;
                                Field {
                                    label: "Apelido";
                                    text <=> root.nick-draft;
                                    placeholder-text: "Como a sala vai te chamar";
                                    init => { self.focus-input(); }
                                    accepted => {
                                        root.set-nickname(root.nick-draft);
                                        root.editing-nick = false;
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: start;
                                    Btn { compact: true; text: "Salvar"; primary: true; clicked => { root.set-nickname(root.nick-draft); root.editing-nick = false; } }
                                    Btn { compact: true; text: "Cancelar"; clicked => { root.editing-nick = false; } }
                                }
                            }
                            if ((m.sharing || m.camera) && !m.me && root.watch-problem == "") || (root.is-owner && !m.me && !m.waiting && root.confirm-remove != i): HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                padding-left: 48px;
                                // Com a grade cheia, só dá para fechar.
                                if m.sharing && !m.me && root.watch-problem == "": Btn {
                                    compact: true;
                                    text: m.watching ? "Fechar tela" : "Ver tela";
                                    label: (m.watching ? "Fechar a tela de " : "Ver a tela de ") + m.label;
                                    icon: @image-url("icons/screen-share.png");
                                    tonal: !m.watching;
                                    enabled: m.watching || !root.grid-full;
                                    clicked => {
                                        if (m.watching) { root.unwatch-member(i); } else { root.watch-member(i); }
                                    }
                                }
                                if m.camera && !m.me && root.watch-problem == "": Btn {
                                    compact: true;
                                    text: m.watching-camera ? "Fechar câmera" : "Ver câmera";
                                    label: (m.watching-camera ? "Fechar a câmera de " : "Ver a câmera de ") + m.label;
                                    icon: @image-url("icons/video.png");
                                    tonal: !m.watching-camera;
                                    enabled: m.watching-camera || !root.grid-full;
                                    clicked => {
                                        if (m.watching-camera) { root.unwatch-camera(i); } else { root.watch-camera(i); }
                                    }
                                }
                                if root.is-owner && !m.me && !m.waiting && root.confirm-remove != i: Btn {
                                    compact: true;
                                    text: "Remover";
                                    danger: true;
                                    clicked => { root.confirm-remove = i; }
                                }
                            }
                            if root.confirm-remove == i: Rectangle {
                                background: Theme.danger-dim;
                                border-radius: Theme.r-control;
                                border-width: 1px;
                                border-color: Theme.danger;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: "Remover troca a chave do grupo: a pessoa não lê mais nada daqui em diante e cai da sala.";
                                        color: Theme.text;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Btn { compact: true; text: "Cancelar"; clicked => { root.confirm-remove = -1; } }
                                        Btn { compact: true; danger: true; text: "Remover"; clicked => { root.remove-member(i); root.confirm-remove = -1; } }
                                    }
                                }
                            }
                        }
                        // Atividade: o que aconteceu na sala, mais quieta que a lista.
                        if root.log.length > 0: VerticalLayout {
                            spacing: 6px;
                            padding-top: 8px;
                            Rule { }
                            Text { text: "Atividade"; color: Theme.text-dim; font-size: 12px; font-weight: 600; }
                            for line in root.log: Small { text: line; }
                        }
                    }
                }
            }
        }
    }

    // Barra de controle (SPEC-05 §4): voz, tela e câmera à esquerda, o estado
    // à direita, numa linha só. Cada estado tem texto, não só cor.
    Rectangle {
        height: 64px;
        background: Theme.surface;
        Rectangle { y: 0; height: 1px; background: Theme.border; }
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 8px;
                alignment: center;
                VerticalLayout {
                    alignment: center;
                    if !root.voice-active: Btn {
                        text: "Entrar na voz";
                        icon: @image-url("icons/microphone.png");
                        primary: true;
                        enabled: root.admitted;
                        clicked => { root.join-voice(); }
                    }
                }
                if root.voice-active: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : root.voice-muted ? "Ativar mic" : "Silenciar";
                        label: root.voice-muted ? "Ativar microfone" : "Silenciar microfone";
                        icon: root.voice-muted ? @image-url("icons/microphone-off.png") : @image-url("icons/microphone.png");
                        on: root.voice-muted;
                        enabled: !root.voice-deafened;
                        clicked => { root.toggle-mute(); }
                    }
                }
                if root.voice-active: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: "";
                        label: root.voice-deafened ? "Voltar a ouvir" : "Ensurdecer";
                        icon: root.voice-deafened ? @image-url("icons/headphones-off.png") : @image-url("icons/headphones.png");
                        on: root.voice-deafened;
                        clicked => { root.toggle-deafen(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Btn {
                        icon: @image-url("icons/adjustments-horizontal.png");
                        label: "Voz e áudio";
                        tonal: root.side-audio;
                        clicked => {
                            root.show-audio = !root.show-audio;
                            if (root.show-audio) { root.audio-settings-opened(); }
                        }
                    }
                }
                if root.voice-active: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: "";
                        label: "Sair da voz";
                        icon: @image-url("icons/phone-off.png");
                        danger: true;
                        clicked => { root.leave-voice(); }
                    }
                }
            }

            Rectangle { width: 1px; height: 28px; y: (parent.height - 28px) / 2; background: Theme.border; }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                if !root.screen-sharing: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : root.monitor-index >= root.monitor-count ? "Compartilhar janela" : "Compartilhar tela";
                        label: root.monitor-index >= root.monitor-count ? "Compartilhar janela" : "Compartilhar tela";
                        icon: @image-url("icons/screen-share.png");
                        enabled: root.admitted && root.can-share;
                        clicked => { root.share-screen(); }
                    }
                }
                if !root.screen-sharing && root.can-share: VerticalLayout {
                    alignment: center;
                    DeviceMenu {
                        title: "O que compartilhar";
                        model: root.monitors;
                        current-index <=> root.monitor-index;
                        opened => { root.share-menu-opened(); }
                    }
                }
                if root.screen-sharing: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : "Parar tela";
                        label: root.monitor-index >= root.monitor-count ? "Parar de compartilhar a janela" : "Parar de compartilhar a tela";
                        icon: @image-url("icons/screen-share-off.png");
                        danger: true;
                        clicked => { root.stop-screen(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                if !root.camera-on: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : root.cameras.length == 0 ? "Sem câmera" : "Ligar câmera";
                        label: root.cameras.length == 0 ? "Nenhuma câmera" : "Ligar câmera";
                        icon: @image-url("icons/video.png");
                        enabled: root.admitted && root.can-share && root.cameras.length > 0;
                        clicked => { root.start-camera(); }
                    }
                }
                if !root.camera-on && root.cameras.length > 1: VerticalLayout {
                    alignment: center;
                    DeviceMenu {
                        title: "Câmera";
                        model: root.cameras;
                        current-index <=> root.camera-index;
                    }
                }
                // Ver a própria imagem (ou esconder a prévia).
                if root.camera-on: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : root.preview-on ? "Esconder prévia" : "Ver minha câmera";
                        label: root.preview-on ? "Esconder a prévia da sua câmera" : "Ver a sua câmera";
                        icon: @image-url("icons/video.png");
                        tonal: !root.preview-on;
                        clicked => { root.toggle-preview(); }
                    }
                }
                if root.camera-on: VerticalLayout {
                    alignment: center;
                    Btn {
                        text: root.narrow ? "" : "Desligar câmera";
                        label: "Desligar câmera";
                        icon: @image-url("icons/video-off.png");
                        danger: true;
                        clicked => { root.stop-camera(); }
                    }
                }
            }

            Rectangle { }

            // Estado, à direita: o que está no ar e o que falta para assistir.
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    horizontal-alignment: right;
                    font-size: 12px;
                    color: !root.voice-active ? Theme.text-dim : (root.voice-deafened || root.voice-muted) ? Theme.warning : Theme.success;
                    text: (!root.voice-active ? "Fora da voz" : root.voice-deafened ? "Ensurdecido" : root.voice-muted ? "Microfone mudo"
                            : root.ptt-key == "" ? "Na voz" : root.me-speaking ? "Transmitindo" : "Segure " + root.ptt-key + " para falar")
                        + (root.screen-sharing ? " · " + (root.monitor-index >= root.monitor-count ? "janela" : "tela") + " no ar, " + (root.screen-watchers == 0 ? "ninguém assistindo" : root.screen-watchers == 1 ? "1 assistindo" : root.screen-watchers + " assistindo")
                            + (root.screen-low-watchers == 0 ? "" : " (" + root.screen-low-watchers + " em qualidade baixa)") : "")
                        + (root.camera-on ? " · câmera: " + (root.camera-watchers == 0 ? "ninguém vendo" : root.camera-watchers == 1 ? "1 vendo" : root.camera-watchers + " vendo") : "");
                    overflow: elide;
                }
                if root.watch-problem != "": Text {
                    text: "Para assistir: " + root.watch-problem;
                    color: Theme.warning;
                    font-size: 12px;
                    horizontal-alignment: right;
                    overflow: elide;
                }
            }
        }
    }
}

struct ThirdParty {
    name: string,
    what: string,
    license: string,
}

// Sobre: versão, seu id, o que o app faz na rede e as licenças de terceiros (SPEC-01 §9).
component AboutView inherits VerticalLayout {
    in property <string> version;
    in property <string> my-id;
    callback back();

    property <[ThirdParty]> libs: [
        { name: "Slint", what: "interface gráfica", license: "Licença Royalty-free do Slint 2.0" },
        { name: "iroh / quinn", what: "rede QUIC e travessia de NAT", license: "MIT ou Apache-2.0" },
        { name: "OpenMLS", what: "criptografia de grupo (MLS)", license: "MIT" },
        { name: "FFmpeg (avcodec, avutil)", what: "decodificação de vídeo; DLLs à parte, que você pode trocar", license: "LGPL 2.1 ou posterior" },
        { name: "Opus (porte em Rust)", what: "codec de voz", license: "BSD-3-Clause" },
        { name: "RNNoise (nnnoiseless)", what: "supressão forte de ruído", license: "BSD-3-Clause" },
        { name: "WebRTC Audio Processing (AEC3)", what: "cancelamento de eco, ruído e ganho", license: "MIT ou BSD-3-Clause" },
        { name: "Tabler Icons", what: "ícones", license: "MIT" },
        { name: "Rust, tokio e demais crates", what: "base do programa", license: "MIT ou Apache-2.0" },
    ];

    TopBar {
        VerticalLayout {
            alignment: center;
            Btn { text: "Voltar"; icon: @image-url("icons/arrow-left.png"); compact: true; clicked => { root.back(); } }
        }
        Text { text: "Sobre o Lerri Chat"; color: Theme.text; font-size: 16px; font-weight: 600; vertical-alignment: center; }
        Rectangle { }
    }

    ScrollView {
        vertical-stretch: 1;
        HorizontalLayout {
            padding: 32px;
            alignment: center;
            VerticalLayout {
                width: 640px;
                alignment: start;
                spacing: 28px;

                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Lerri Chat " + root.version; color: Theme.text; font-size: 22px; font-weight: 600; }
                    Dim { text: "Voz, chat, tela e câmera entre amigos, cifrados de ponta a ponta. Sem conta e sem servidor de terceiros: só o seu PC, o dos seus amigos e, se você quiser, o seu próprio relay."; }
                    HorizontalLayout {
                        spacing: 6px;
                        padding-top: 4px;
                        alignment: start;
                        Small { text: "Seu id"; wrap: no-wrap; vertical-alignment: center; }
                        Text { text: root.my-id + "…"; color: Theme.text-dim; font-family: "Cascadia Mono"; font-size: 12px; vertical-alignment: center; }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Heading { text: "Rede e firewall"; }
                    Dim { text: "Quem cria uma sala x1 ou roda um relay recebe conexões, e o Windows pode perguntar se o Lerri Chat pode usar a rede. Permita nas redes privadas, senão ninguém de fora consegue entrar. Quem só entra em salas não recebe conexões e não vê essa pergunta."; }
                    Dim { text: "O app só fala com o host da sala (o PC de quem criou ou o relay do convite) e com os outros membros. Nenhum STUN, relay ou serviço de terceiros."; }
                }

                VerticalLayout {
                    spacing: 4px;
                    Heading { text: "Software de terceiros"; }
                    for lib[i] in root.libs: VerticalLayout {
                        if i > 0: Rule { }
                        HorizontalLayout {
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: lib.name; color: Theme.text; font-weight: 600; wrap: word-wrap; }
                                Small { text: lib.what; }
                            }
                            Text { text: lib.license; color: Theme.text-dim; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; width: 220px; wrap: word-wrap; }
                        }
                    }
                }

                Panel {
                    height: 170px;
                    AboutSlint { }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Lerri Chat";
    icon: @image-url("icon.png");
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.ink;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    // "home", "busy", "room" ou "about".
    in-out property <string> screen: "home";
    in property <string> version;
    in property <string> busy-text;
    in-out property <string> error-text;

    in property <string> my-id;
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;

    in property <string> room-id;
    in property <string> room-kind;
    in property <string> room-info;
    in property <bool> is-x1;
    // Janela estreita (o Rust confere a cada 150 ms): a voz fica só com ícones.
    in property <bool> narrow;
    in property <bool> reduce-motion;
    in property <bool> anyone-speaking;
    in property <string> room-status;
    in property <string> route-text;
    in property <int> route-quality;
    in property <string> reach-text;
    in property <string> reach-note;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <bool> copy-ok;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    in property <[string]> audio-inputs: ["Padrão do Windows"];
    in property <[string]> audio-outputs: ["Padrão do Windows"];
    in-out property <int> input-index;
    in-out property <int> output-index;
    in property <string> ptt-key;
    in property <bool> ptt-capturing;
    in property <bool> me-speaking;
    callback audio-settings-opened();
    callback input-changed(int);
    callback output-changed(int);
    callback ptt-mode(bool);
    callback change-ptt-key();
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    in property <int> screen-low-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in property <int> monitor-count;
    callback share-menu-opened();
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    in property <[VideoTile]> tiles;
    in property <int> max-tiles: 4;
    in property <bool> preview-on;
    callback toggle-preview();
    callback set-nickname(string);
    out property <length> stage-x: room-view.stage-x;
    out property <length> stage-y: room-view.stage-y;
    out property <length> stage-width: room-view.stage-width;
    out property <length> stage-height: room-view.stage-height;

    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch-member(int);
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera(int);
    callback close-tile(int);
    callback scroll-chat-to-end();
    scroll-chat-to-end => { room-view.scroll-to-end(); }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Trocar isto redesenha a janela inteira. O Rust troca quando uma janela
    // de vídeo (filha) sai de cima de uma área: o renderer só repinta o que
    // mudou, e o que ele pintou embaixo da janela-filha nunca chegou à tela.
    in property <bool> repaint-all;
    Rectangle {
        background: root.repaint-all ? #00000001 : transparent;
    }

    VerticalLayout {
        if root.error-text != "": Rectangle {
            background: Theme.danger-dim;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.danger; }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 10px;
                VerticalLayout { alignment: center; Icon { source: @image-url("icons/alert-triangle.png"); colorize: Theme.danger; } }
                Text { text: root.error-text; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Btn { compact: true; text: "Fechar"; icon: @image-url("icons/x.png"); clicked => { root.error-text = ""; } }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            HomeView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "home";
                saved-rooms: root.saved-rooms;
                join-link <=> root.join-link;
                via-link <=> root.via-link;
                admin-link <=> root.admin-link;
                nickname <=> root.nickname;
                keep-history <=> root.keep-history;
                join => { root.join(); }
                create-x1 => { root.create-x1(); }
                create-server => { root.create-server(); }
                open-room(i) => { root.open-room(i); }
                save-settings => { root.save-settings(); }
                about => { root.screen = "about"; }
            }

            if root.screen == "about": AboutView {
                width: parent.width;
                height: parent.height;
                version: root.version;
                my-id: root.my-id;
                back => { root.screen = "home"; }
            }

            if root.screen == "busy": BusyView {
                width: parent.width;
                height: parent.height;
                text: root.busy-text;
            }

            room-view := RoomView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "room";
                room-id: root.room-id;
                room-kind: root.room-kind;
                room-info: root.room-info;
                is-x1: root.is-x1;
                narrow: root.narrow;
                reduce-motion: root.reduce-motion;
                anyone-speaking: root.anyone-speaking;
                room-status: root.room-status;
                route-text: root.route-text;
                route-quality: root.route-quality;
                reach-text: root.reach-text;
                reach-note: root.reach-note;
                reach-warning: root.reach-warning;
                is-owner: root.is-owner;
                show-invite <=> root.show-invite;
                invite-link: root.invite-link;
                invite-qr: root.invite-qr;
                copy-status: root.copy-status;
                copy-ok: root.copy-ok;
                chat: root.chat;
                chat-draft <=> root.chat-draft;
                members: root.members;
                log: root.log;
                voice-active: root.voice-active;
                voice-muted: root.voice-muted;
                voice-deafened: root.voice-deafened;
                voice-strong-ns <=> root.voice-strong-ns;
                voice-devices: root.voice-devices;
                audio-inputs: root.audio-inputs;
                audio-outputs: root.audio-outputs;
                input-index <=> root.input-index;
                output-index <=> root.output-index;
                ptt-key: root.ptt-key;
                ptt-capturing: root.ptt-capturing;
                me-speaking: root.me-speaking;
                audio-settings-opened => { root.audio-settings-opened(); }
                input-changed(i) => { root.input-changed(i); }
                output-changed(i) => { root.output-changed(i); }
                ptt-mode(on) => { root.ptt-mode(on); }
                change-ptt-key => { root.change-ptt-key(); }
                screen-sharing: root.screen-sharing;
                screen-info: root.screen-info;
                screen-watchers: root.screen-watchers;
                screen-low-watchers: root.screen-low-watchers;
                can-share: root.can-share;
                watch-problem: root.watch-problem;
                monitors: root.monitors;
                monitor-index <=> root.monitor-index;
                monitor-count: root.monitor-count;
                share-menu-opened => { root.share-menu-opened(); }
                camera-on: root.camera-on;
                camera-info: root.camera-info;
                camera-watchers: root.camera-watchers;
                cameras: root.cameras;
                camera-index <=> root.camera-index;
                tiles: root.tiles;
                max-tiles: root.max-tiles;
                preview-on: root.preview-on;
                toggle-preview => { root.toggle-preview(); }
                nickname: root.nickname;
                set-nickname(nick) => { root.set-nickname(nick); }
                join-voice => { root.join-voice(); }
                leave-voice => { root.leave-voice(); }
                toggle-mute => { root.toggle-mute(); }
                toggle-deafen => { root.toggle-deafen(); }
                strong-ns-changed => { root.strong-ns-changed(); }
                share-screen => { root.share-screen(); }
                stop-screen => { root.stop-screen(); }
                watch-member(i) => { root.watch-member(i); }
                unwatch-member(i) => { root.unwatch-member(i); }
                start-camera => { root.start-camera(); }
                stop-camera => { root.stop-camera(); }
                watch-camera(i) => { root.watch-camera(i); }
                unwatch-camera(i) => { root.unwatch-camera(i); }
                close-tile(i) => { root.close-tile(i); }
                new-invite => { root.new-invite(); }
                copy-invite => { root.copy-invite(); }
                send-chat => { root.send-chat(); }
                remove-member(i) => { root.remove-member(i); }
                disconnect => { root.disconnect(); }
                leave-room => { root.leave-room(); }
            }
        }
    }
}
