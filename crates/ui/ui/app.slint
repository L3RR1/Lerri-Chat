// Interface mínima (SPEC-05): início, espera e sala com chat.
// Só tokens da paleta; nenhuma animação.

import { LineEdit, ScrollView, CheckBox, ComboBox, Palette } from "std-widgets.slint";

global Theme {
    out property <color> ink: #0B0710;
    out property <color> surface: #140D1F;
    out property <color> surface-raised: #1D1430;
    out property <color> surface-hover: #271A42;
    out property <color> border: #2E2142;
    out property <color> violet: #A855F7;
    out property <color> violet-bright: #C084FC;
    out property <color> violet-deep: #7C3AED;
    out property <color> violet-glow: #A855F740;
    out property <color> text: #F4F0FA;
    out property <color> text-dim: #B3A7C9;
    out property <color> text-mute: #6E6384;
    out property <color> success: #34D399;
    out property <color> warning: #FBBF24;
    out property <color> danger: #F87171;
}

export struct SavedRoomRow {
    id: string,
    label: string,
}

export struct ChatRow {
    who: string,
    text: string,
    time: string,
    mine: bool,
}

export struct MemberRow {
    label: string,
    online: bool,
    owner: bool,
    me: bool,
    waiting: bool,
    in-voice: bool,
    speaking: bool,
    sharing: bool,
    watching: bool,
    camera: bool,
    watching-camera: bool,
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> danger;
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    callback clicked;
    height: 36px;
    min-width: label.preferred-width + 32px;
    border-radius: 6px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.danger : Theme.border;
    background: !enabled ? Theme.surface-raised
        : primary ? (ta.pressed ? Theme.violet-deep : ta.has-hover ? Theme.violet-bright : Theme.violet)
        : (ta.has-hover ? Theme.surface-hover : transparent);
    accessible-role: button;
    accessible-label: text;
    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
    label := Text {
        width: 100%;
        height: 100%;
        text: root.text;
        font-size: root.font-size;
        color: !root.enabled ? Theme.text-mute : root.primary ? Theme.ink : root.danger ? Theme.danger : Theme.text;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Card inherits Rectangle {
    background: Theme.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
}

component Title inherits Text {
    color: Theme.text;
    font-size: 20px;
    font-weight: 600;
}

component Dim inherits Text {
    color: Theme.text-dim;
    wrap: word-wrap;
}

component Dot inherits Rectangle {
    in property <color> tone;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: tone;
}

// Presença na lista de membros: ponto de online; na voz, anel roxo estático
// enquanto fala (SPEC-05: sem animação contínua no renderer software).
component Presence inherits Rectangle {
    in property <bool> online;
    in property <bool> speaking;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background: speaking ? Theme.violet-glow : transparent;
    border-width: speaking ? 2px : 0px;
    border-color: Theme.violet-bright;
    Dot {
        x: 3px;
        y: 3px;
        tone: root.online ? Theme.success : Theme.text-mute;
    }
}

component HomeView inherits VerticalLayout {
    in property <string> my-id;
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;
    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();

    padding: 24px;
    spacing: 16px;

    HorizontalLayout {
        spacing: 16px;
        Text { text: "Lerri Chat"; color: Theme.text; font-size: 28px; font-weight: 600; vertical-alignment: center; }
        Rectangle { }
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Apelido"; color: Theme.text-dim; vertical-alignment: center; }
                LineEdit {
                    width: 200px;
                    text <=> root.nickname;
                    placeholder-text: "opcional, só a sala vê";
                    edited => { root.save-settings(); }
                }
            }
            HorizontalLayout {
                alignment: end;
                CheckBox {
                    text: "Guardar histórico do chat neste PC";
                    checked <=> root.keep-history;
                    toggled => { root.save-settings(); }
                }
            }
            Text { text: "id: " + root.my-id + "…"; color: Theme.text-mute; font-family: "Cascadia Mono"; font-size: 12px; horizontal-alignment: right; }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Entrar numa sala"; }
                Dim { text: "Cole o convite que recebeu (lerrichat://join…)."; }
                LineEdit {
                    text <=> root.join-link;
                    placeholder-text: "lerrichat://join?…";
                    accepted => { root.join(); }
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Entrar"; primary: true; enabled: root.join-link != ""; clicked => { root.join(); } }
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Criar sala x1"; }
                Dim { text: "Sala direta entre dois PCs, hospedada neste aqui. Acaba quando você fechar o app."; }
                LineEdit {
                    text <=> root.via-link;
                    placeholder-text: "opcional: link público do seu relay (lerrichat://relay…)";
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Criar sala x1"; primary: true; clicked => { root.create-x1(); } }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: 16px;
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Minhas salas"; }
                if root.saved-rooms.length == 0: Dim { text: "Nenhuma sala salva. Salas de servidor aparecem aqui depois que você entra nelas."; }
                for room[i] in root.saved-rooms: HorizontalLayout {
                    spacing: 12px;
                    Text { text: room.id; color: Theme.text; font-family: "Cascadia Mono"; vertical-alignment: center; }
                    Text { text: room.label; color: Theme.text-dim; vertical-alignment: center; }
                    Rectangle { }
                    Btn { text: "Abrir"; clicked => { root.open-room(i); } }
                }
            }
        }
        Card {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: start;
                Title { text: "Criar sala num servidor"; }
                Dim { text: "Para quem roda um relay (lerrichat-host). Use o link de administração que ele mostra."; }
                LineEdit {
                    text <=> root.admin-link;
                    placeholder-text: "lerrichat://admin?…";
                    input-type: password;
                }
                HorizontalLayout {
                    alignment: start;
                    Btn { text: "Criar no servidor"; enabled: root.admin-link != ""; clicked => { root.create-server(); } }
                }
            }
        }
    }
    Rectangle { }
}

component RoomView inherits HorizontalLayout {
    in property <string> room-id;
    in property <string> room-info;
    in property <string> room-status;
    in property <string> route-text;
    in property <bool> route-direct;
    in property <string> reach-text;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    // Tela: a nossa e a que assistimos.
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in property <string> watching-label;
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch();
    // Câmera: a nossa e a que assistimos.
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    in property <string> watching-cam-label;
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera();
    // Onde as janelas de vídeo (filhas, D3D11) ficam, em pixels lógicos.
    out property <length> video-x: video-box.absolute-position.x;
    out property <length> video-y: video-box.absolute-position.y;
    out property <length> video-width: video-box.width;
    out property <length> video-height: video-box.height;
    out property <length> cam-x: cam-box.absolute-position.x;
    out property <length> cam-y: cam-box.absolute-position.y;
    out property <length> cam-width: cam-box.width;
    out property <length> cam-height: cam-box.height;

    property <bool> confirm-leave;
    property <int> confirm-remove: -1;

    public function scroll-to-end() {
        chat-sv.content-y = min(0px, chat-sv.visible-height - chat-sv.content-height);
    }

    padding: 20px;
    spacing: 16px;

    VerticalLayout {
        spacing: 12px;
        horizontal-stretch: 1;

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                Title { text: "Sala " + root.room-id; font-family: "Cascadia Mono"; }
                Dim { text: root.room-info; }
            }
            Rectangle { }
            if root.is-owner: VerticalLayout {
                alignment: center;
                Btn { text: root.show-invite ? "Ocultar convite" : "Convidar"; clicked => { root.show-invite = !root.show-invite; } }
            }
            VerticalLayout {
                alignment: center;
                Btn { text: "Desconectar"; clicked => { root.disconnect(); } }
            }
            if !root.is-owner: VerticalLayout {
                alignment: center;
                Btn {
                    text: root.confirm-leave ? "Confirmar: sair de vez" : "Sair da sala";
                    danger: true;
                    clicked => {
                        if (root.confirm-leave) { root.leave-room(); } else { root.confirm-leave = true; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; Dot { tone: root.route-text == "" ? Theme.text-mute : root.route-direct ? Theme.success : Theme.warning; } }
            Text { text: root.route-text == "" ? "sem conexão" : root.route-text; color: Theme.text-dim; vertical-alignment: center; }
        }

        if root.room-status != "": Rectangle {
            background: Theme.surface-raised;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.warning;
            HorizontalLayout {
                padding: 12px;
                Text { text: root.room-status; color: Theme.warning; wrap: word-wrap; }
            }
        }

        if root.show-invite && root.reach-text != "": Card {
            border-color: root.reach-warning ? Theme.warning : Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                Text { text: "Endereços no convite"; color: Theme.text; font-weight: 600; }
                Text { text: root.reach-text; color: root.reach-warning ? Theme.warning : Theme.text-dim; wrap: word-wrap; font-family: "Cascadia Mono"; font-size: 12px; }
            }
        }

        if root.is-owner && root.show-invite: Card {
            HorizontalLayout {
                padding: 14px;
                spacing: 16px;
                if root.invite-link == "": Rectangle {
                    width: 168px;
                    height: 168px;
                    background: Theme.surface-raised;
                    border-radius: 4px;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        text: "Clique em \"Novo convite\" para gerar um link e o QR.";
                        color: Theme.text-dim;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if root.invite-link != "": Rectangle {
                    width: 168px;
                    height: 168px;
                    background: white;
                    border-radius: 4px;
                    Image { width: 160px; height: 160px; source: root.invite-qr; image-rendering: pixelated; }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Convite"; color: Theme.text; font-weight: 600; }
                    Dim { text: "Uso único, válido por 24 h. Envie por um canal confiável."; }
                    Rectangle {
                        background: Theme.surface-raised;
                        border-radius: 6px;
                        min-height: 56px;
                        Text {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            height: parent.height - 16px;
                            text: root.invite-link;
                            color: Theme.text-dim;
                            font-family: "Cascadia Mono";
                            font-size: 11px;
                            wrap: char-wrap;
                            overflow: elide;
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Btn { text: "Copiar link"; primary: true; enabled: root.invite-link != ""; clicked => { root.copy-invite(); } }
                        Btn { text: "Novo convite"; clicked => { root.new-invite(); } }
                        Text { text: root.copy-status; color: Theme.success; vertical-alignment: center; }
                    }
                }
            }
        }

        // Vídeo assistido: tela à esquerda, câmera à direita. Cada imagem é
        // uma janela-filha (D3D11) posta em cima da sua caixa; a UI não
        // desenha nada ali. Sem nada assistido, altura zero.
        Rectangle {
            property <bool> any: root.watching-label != "" || root.watching-cam-label != "";
            vertical-stretch: any ? 3 : 0;
            max-height: any ? 100000px : 0px;
            min-height: any ? 240px : 0px;
            background: Theme.surface;
            border-radius: 8px;
            border-width: any ? 1px : 0px;
            border-color: Theme.border;
            clip: true;
            HorizontalLayout {
                visible: parent.any;
                padding: 8px;
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: root.watching-label != "" ? 3 : 0;
                    max-width: root.watching-label != "" ? 100000px : 0px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Tela de " + root.watching-label; color: Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Rectangle { }
                        Btn { height: 28px; font-size: 12px; text: "Fechar"; clicked => { root.unwatch(); } }
                    }
                    video-box := Rectangle {
                        vertical-stretch: 1;
                        background: Theme.ink;
                        Text { text: "Aguardando a imagem…"; color: Theme.text-mute; }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: root.watching-cam-label != "" ? 1 : 0;
                    max-width: root.watching-cam-label != "" ? 100000px : 0px;
                    min-width: root.watching-cam-label != "" ? 220px : 0px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Câmera de " + root.watching-cam-label; color: Theme.text; font-weight: 600; vertical-alignment: center; overflow: elide; }
                        Rectangle { }
                        Btn { height: 28px; font-size: 12px; text: "Fechar"; clicked => { root.unwatch-camera(); } }
                    }
                    cam-box := Rectangle {
                        vertical-stretch: 1;
                        background: Theme.ink;
                        Text { text: "Aguardando a imagem…"; color: Theme.text-mute; }
                    }
                }
            }
        }

        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                chat-sv := ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 10px;
                        if root.chat.length == 0: Dim { text: "Nenhuma mensagem ainda. As mensagens são cifradas no seu PC; o servidor só repassa bytes."; }
                        for line in root.chat: VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: line.who; color: line.mine ? Theme.violet-bright : Theme.text; font-weight: 600; }
                                Text { text: line.time; color: Theme.text-mute; font-size: 12px; vertical-alignment: center; }
                            }
                            Text { text: line.text; color: Theme.text; wrap: word-wrap; }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit {
                        text <=> root.chat-draft;
                        placeholder-text: root.room-status != "" ? "aguardando admissão…" : "Mensagem";
                        enabled: root.room-status == "";
                        accepted => { root.send-chat(); }
                    }
                    Btn { text: "Enviar"; primary: true; enabled: root.room-status == "" && root.chat-draft != ""; clicked => { root.send-chat(); } }
                }
            }
        }
    }

    VerticalLayout {
        width: 280px;
        spacing: 12px;
        Card {
            border-color: root.voice-active ? Theme.violet : Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    Text { text: "Voz"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                    Rectangle { }
                    Text {
                        text: !root.voice-active ? "fora" : root.voice-deafened ? "ensurdecido" : root.voice-muted ? "mudo" : "conectado";
                        color: !root.voice-active ? Theme.text-mute : (root.voice-deafened || root.voice-muted) ? Theme.warning : Theme.success;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if !root.voice-active: Btn {
                    text: "Entrar na voz";
                    primary: true;
                    enabled: root.room-status == "";
                    clicked => { root.join-voice(); }
                }
                if root.voice-active: HorizontalLayout {
                    spacing: 6px;
                    Btn { horizontal-stretch: 1; height: 30px; font-size: 13px; text: root.voice-muted ? "Ativar mic" : "Mudo"; enabled: !root.voice-deafened; clicked => { root.toggle-mute(); } }
                    Btn { horizontal-stretch: 1; height: 30px; font-size: 13px; text: root.voice-deafened ? "Ouvir" : "Ensurdecer"; clicked => { root.toggle-deafen(); } }
                    Btn { horizontal-stretch: 1; height: 30px; font-size: 13px; text: "Sair"; danger: true; clicked => { root.leave-voice(); } }
                }
                CheckBox {
                    text: "Supressão forte de ruído";
                    checked <=> root.voice-strong-ns;
                    toggled => { root.strong-ns-changed(); }
                }
                if root.voice-devices != "": Text { text: root.voice-devices; color: Theme.text-mute; font-size: 11px; wrap: word-wrap; }
            }
        }
        Card {
            border-color: root.screen-sharing ? Theme.violet : Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    Text { text: "Tela"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                    Rectangle { }
                    Text {
                        text: !root.screen-sharing ? "" : root.screen-watchers == 0 ? "no ar · ninguém assistindo" : root.screen-watchers == 1 ? "no ar · 1 assistindo" : "no ar · " + root.screen-watchers + " assistindo";
                        color: Theme.success;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if !root.screen-sharing && root.monitors.length > 1: ComboBox {
                    model: root.monitors;
                    current-index <=> root.monitor-index;
                }
                if !root.screen-sharing: Btn {
                    text: "Compartilhar tela";
                    primary: true;
                    enabled: root.room-status == "" && root.can-share;
                    clicked => { root.share-screen(); }
                }
                if root.screen-sharing: Btn { text: "Parar de compartilhar"; danger: true; clicked => { root.stop-screen(); } }
                if root.screen-info != "": Text { text: root.screen-info; color: Theme.text-mute; font-size: 11px; wrap: word-wrap; }
                if root.watch-problem != "": Text { text: "Para assistir: " + root.watch-problem; color: Theme.warning; font-size: 11px; wrap: word-wrap; }
            }
        }
        Card {
            border-color: root.camera-on ? Theme.violet : Theme.border;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;
                HorizontalLayout {
                    Text { text: "Câmera"; color: Theme.text; font-weight: 600; vertical-alignment: center; }
                    Rectangle { }
                    Text {
                        text: !root.camera-on ? "" : root.camera-watchers == 0 ? "ligada · ninguém vendo" : root.camera-watchers == 1 ? "ligada · 1 vendo" : "ligada · " + root.camera-watchers + " vendo";
                        color: Theme.success;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
                if !root.camera-on && root.cameras.length > 1: ComboBox {
                    model: root.cameras;
                    current-index <=> root.camera-index;
                }
                if !root.camera-on: Btn {
                    text: root.cameras.length == 0 ? "Nenhuma câmera" : "Ligar câmera";
                    primary: true;
                    enabled: root.room-status == "" && root.can-share && root.cameras.length > 0;
                    clicked => { root.start-camera(); }
                }
                if root.camera-on: Btn { text: "Desligar câmera"; danger: true; clicked => { root.stop-camera(); } }
                if root.camera-info != "": Text { text: root.camera-info; color: Theme.text-mute; font-size: 11px; wrap: word-wrap; }
            }
        }
        Card {
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                alignment: start;
                Text { text: "Membros"; color: Theme.text; font-weight: 600; }
                for m[i] in root.members: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout { alignment: center; Presence { online: m.online; speaking: m.speaking; } }
                    VerticalLayout {
                        alignment: center;
                        Text { text: m.label; color: m.online ? Theme.text : Theme.text-dim; overflow: elide; }
                        if m.owner || m.waiting || m.in-voice || m.sharing || m.camera: Text {
                            text: (m.owner ? "dono" : m.waiting ? "aguardando admissão" : "")
                                + (m.in-voice ? ((m.owner || m.waiting) ? " · " : "") + (m.speaking ? "falando" : "na voz") : "")
                                + (m.sharing ? ((m.owner || m.waiting || m.in-voice) ? " · " : "") + "compartilhando" : "")
                                + (m.camera ? ((m.owner || m.waiting || m.in-voice || m.sharing) ? " · " : "") + "câmera" : "");
                            color: m.speaking ? Theme.violet-bright : m.waiting ? Theme.warning : m.owner ? Theme.violet-bright : Theme.text-dim;
                            font-size: 11px;
                        }
                    }
                    Rectangle { }
                    if m.sharing && !m.me && root.watch-problem == "": Btn {
                        height: 26px;
                        font-size: 12px;
                        text: m.watching ? "Fechar" : "Assistir";
                        primary: !m.watching;
                        clicked => {
                            if (m.watching) { root.unwatch(); } else { root.watch-member(i); }
                        }
                    }
                    if m.camera && !m.me && root.watch-problem == "": Btn {
                        height: 26px;
                        font-size: 12px;
                        text: m.watching-camera ? "Fechar" : "Câmera";
                        primary: !m.watching-camera;
                        clicked => {
                            if (m.watching-camera) { root.unwatch-camera(); } else { root.watch-camera(i); }
                        }
                    }
                    if root.is-owner && !m.me && !m.waiting: Btn {
                        height: 26px;
                        font-size: 12px;
                        text: root.confirm-remove == i ? "Confirmar" : "Remover";
                        danger: true;
                        clicked => {
                            if (root.confirm-remove == i) { root.remove-member(i); root.confirm-remove = -1; } else { root.confirm-remove = i; }
                        }
                    }
                }
            }
        }
        Card {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                Text { text: "Atividade"; color: Theme.text; font-weight: 600; }
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        spacing: 4px;
                        for line in root.log: Text { text: line; color: Theme.text-dim; wrap: word-wrap; font-size: 12px; }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Lerri Chat";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: Theme.ink;
    default-font-family: "Segoe UI";
    default-font-size: 14px;

    // "home", "busy" ou "room".
    in property <string> screen: "home";
    in property <string> busy-text;
    in-out property <string> error-text;

    in property <string> my-id;
    in property <[SavedRoomRow]> saved-rooms;
    in-out property <string> join-link;
    in-out property <string> via-link;
    in-out property <string> admin-link;
    in-out property <string> nickname;
    in-out property <bool> keep-history;

    in property <string> room-id;
    in property <string> room-info;
    in property <string> room-status;
    in property <string> route-text;
    in property <bool> route-direct;
    in property <string> reach-text;
    in property <bool> reach-warning;
    in property <bool> is-owner;
    in-out property <bool> show-invite;
    in property <string> invite-link;
    in property <image> invite-qr;
    in property <string> copy-status;
    in property <[ChatRow]> chat;
    in-out property <string> chat-draft;
    in property <[MemberRow]> members;
    in property <[string]> log;
    in property <bool> voice-active;
    in property <bool> voice-muted;
    in property <bool> voice-deafened;
    in-out property <bool> voice-strong-ns;
    in property <string> voice-devices;
    in property <bool> screen-sharing;
    in property <string> screen-info;
    in property <int> screen-watchers;
    in property <bool> can-share;
    in property <string> watch-problem;
    in property <[string]> monitors;
    in-out property <int> monitor-index;
    in property <string> watching-label;
    out property <length> video-x: room-view.video-x;
    out property <length> video-y: room-view.video-y;
    out property <length> video-width: room-view.video-width;
    out property <length> video-height: room-view.video-height;
    in property <bool> camera-on;
    in property <string> camera-info;
    in property <int> camera-watchers;
    in property <[string]> cameras;
    in-out property <int> camera-index;
    in property <string> watching-cam-label;
    out property <length> cam-x: room-view.cam-x;
    out property <length> cam-y: room-view.cam-y;
    out property <length> cam-width: room-view.cam-width;
    out property <length> cam-height: room-view.cam-height;

    callback join();
    callback create-x1();
    callback create-server();
    callback open-room(int);
    callback save-settings();
    callback new-invite();
    callback copy-invite();
    callback send-chat();
    callback remove-member(int);
    callback disconnect();
    callback leave-room();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback strong-ns-changed();
    callback share-screen();
    callback stop-screen();
    callback watch-member(int);
    callback unwatch();
    callback start-camera();
    callback stop-camera();
    callback watch-camera(int);
    callback unwatch-camera();
    callback scroll-chat-to-end();
    scroll-chat-to-end => { room-view.scroll-to-end(); }

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        if root.error-text != "": Rectangle {
            background: Theme.surface-raised;
            border-width: 1px;
            border-color: Theme.danger;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Text { text: root.error-text; color: Theme.danger; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { horizontal-stretch: 0; text: "Fechar"; clicked => { root.error-text = ""; } }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            HomeView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "home";
                my-id: root.my-id;
                saved-rooms: root.saved-rooms;
                join-link <=> root.join-link;
                via-link <=> root.via-link;
                admin-link <=> root.admin-link;
                nickname <=> root.nickname;
                keep-history <=> root.keep-history;
                join => { root.join(); }
                create-x1 => { root.create-x1(); }
                create-server => { root.create-server(); }
                open-room(i) => { root.open-room(i); }
                save-settings => { root.save-settings(); }
            }

            if root.screen == "busy": Text {
                width: parent.width;
                height: parent.height;
                text: root.busy-text;
                color: Theme.text-dim;
                font-size: 16px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            room-view := RoomView {
                width: parent.width;
                height: parent.height;
                visible: root.screen == "room";
                room-id: root.room-id;
                room-info: root.room-info;
                room-status: root.room-status;
                route-text: root.route-text;
                route-direct: root.route-direct;
                reach-text: root.reach-text;
                reach-warning: root.reach-warning;
                is-owner: root.is-owner;
                show-invite <=> root.show-invite;
                invite-link: root.invite-link;
                invite-qr: root.invite-qr;
                copy-status: root.copy-status;
                chat: root.chat;
                chat-draft <=> root.chat-draft;
                members: root.members;
                log: root.log;
                voice-active: root.voice-active;
                voice-muted: root.voice-muted;
                voice-deafened: root.voice-deafened;
                voice-strong-ns <=> root.voice-strong-ns;
                voice-devices: root.voice-devices;
                screen-sharing: root.screen-sharing;
                screen-info: root.screen-info;
                screen-watchers: root.screen-watchers;
                can-share: root.can-share;
                watch-problem: root.watch-problem;
                monitors: root.monitors;
                monitor-index <=> root.monitor-index;
                watching-label: root.watching-label;
                camera-on: root.camera-on;
                camera-info: root.camera-info;
                camera-watchers: root.camera-watchers;
                cameras: root.cameras;
                camera-index <=> root.camera-index;
                watching-cam-label: root.watching-cam-label;
                join-voice => { root.join-voice(); }
                leave-voice => { root.leave-voice(); }
                toggle-mute => { root.toggle-mute(); }
                toggle-deafen => { root.toggle-deafen(); }
                strong-ns-changed => { root.strong-ns-changed(); }
                share-screen => { root.share-screen(); }
                stop-screen => { root.stop-screen(); }
                watch-member(i) => { root.watch-member(i); }
                unwatch => { root.unwatch(); }
                start-camera => { root.start-camera(); }
                stop-camera => { root.stop-camera(); }
                watch-camera(i) => { root.watch-camera(i); }
                unwatch-camera => { root.unwatch-camera(); }
                new-invite => { root.new-invite(); }
                copy-invite => { root.copy-invite(); }
                send-chat => { root.send-chat(); }
                remove-member(i) => { root.remove-member(i); }
                disconnect => { root.disconnect(); }
                leave-room => { root.leave-room(); }
            }
        }
    }
}
